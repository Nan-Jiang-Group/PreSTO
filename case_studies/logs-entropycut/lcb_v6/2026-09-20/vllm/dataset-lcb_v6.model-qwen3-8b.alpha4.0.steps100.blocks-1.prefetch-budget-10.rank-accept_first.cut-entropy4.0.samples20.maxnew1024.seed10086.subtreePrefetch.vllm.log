    input = sys.stdin.read().split()
    ptr = 0
    N = int(input[ptr])
    ptr += 1

    max_rating = 500000
    diff = [0] * (max_rating + 2)  # 1-based to 500000

    for _ in range(N):
        L = int(input[ptr])
        R = int(input[ptr + 1])
        ptr += 2
        diff[L] += 1
        if R + 1 <= max_rating:
            diff[R + 1] -= 1

    # Compute prefix sum to get the count for each x
    prefix = [0] * (max_rating + 1)
    for i in range(1, max_rating + 1):
        prefix[i] = prefix[i - 1] + diff[i]

    Q = int(input[ptr])
    ptr += 1

