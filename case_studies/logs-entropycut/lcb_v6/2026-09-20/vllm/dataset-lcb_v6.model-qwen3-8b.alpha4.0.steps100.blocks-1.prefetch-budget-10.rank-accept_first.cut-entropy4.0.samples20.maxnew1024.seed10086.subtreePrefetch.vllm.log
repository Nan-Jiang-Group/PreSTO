    max_n = N * (N - 1) // 2
    comb = [[0] * (max_n + 1) for _ in range(N + 1)]
    for n in range(N + 1):
        comb[n][0] = 1
        for m in range(1, max_n + 1):
            comb[n][m] = comb[n-1][m-1] + comb[n-1][m]
            if comb[n][m] >= P:
                comb[n][m] -= P
    
    # Precompute factorial and inverse factorial modulo P
    fact = [1] * (max_n + 1)
    inv_fact = [1] * (max_n + 1)
    for i in range(1, max_n + 1):
        fact[i] = fact[i-1] * i % P
    inv_fact[max_n] = pow(fact[max_n], P-2, P)
    for i in range(max_n - 1, -1, -1):
        inv_fact[i] = inv_fact[i+1] * (i+1) % P
    
    def comb_mod(n, k):
        if k < 0 or k > n:
            return 0
        return fact[n] * inv_fact[k] % P * inv_fact[n - k] % P
    
