```python
import sys

def solve():
    # Read S from standard input
    # Using sys.stdin.read().strip() or input()
    # Since S is a single string, input() is fine.
    try:
        s = input()
        # Extract first character
        first_char = s[0]
        # Concatenate with UPC
        result = first_char + "UPC"
        # Print result
        print(result)
    except EOFError:
        pass

if __name__ == '__main__':
    solve()
```
