```python
import sys

def main():
    # Read the input string S from standard input
    # Using sys.stdin.read().strip() handles potential surrounding whitespace/newlines robustly
    S = sys.stdin.read().strip()
    
    # Extract the first character (first digit)
    first_digit = int(S[0])
    
    # Extract the third character (second digit)
    second_digit = int(S[2])
    
    # Calculate the product
    product = first_digit * second_digit
    
    # Print the result
    print(product)

if __name__ == "__main__":
    main()

