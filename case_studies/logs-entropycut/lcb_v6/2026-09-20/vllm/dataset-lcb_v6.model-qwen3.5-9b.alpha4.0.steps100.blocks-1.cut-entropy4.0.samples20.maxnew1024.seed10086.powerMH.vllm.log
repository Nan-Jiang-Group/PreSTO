[run_powersampling_mh_vllm] INFO: sample 5 response_length=2756 prediction=import sys

def solve():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        for _ in range(N):
            t = int(next(iterator))
            l = int(next(iterator))
            snakes.append((t, l))
            
        # Process for each k from 1 to D
        for k in range(1, D + 1):
            max_weight = 0
            for t, l in snakes:
                weight = t * (l + k)
                if weight > max_weight:
                    max_weight = weight
            print(max_weight)
            
    except StopIteration:
        pass

if __name__ == '__main__':
    solve() is_correct=True justification=
