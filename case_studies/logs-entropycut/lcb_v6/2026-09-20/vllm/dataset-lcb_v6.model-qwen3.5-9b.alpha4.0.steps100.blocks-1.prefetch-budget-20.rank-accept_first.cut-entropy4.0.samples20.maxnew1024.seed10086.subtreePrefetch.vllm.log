```python
import sys

def main():
    # Read input
    line = sys.stdin.read().strip()
    if not line:
        return
    parts = line.split()
    if len(parts) >= 2:
        A = int(parts[0])
        B = int(parts[1])
        
        # Calculate and print
        result = (A + B) ** 2
        print(result)

if __name__ == '__main__':
    main()
```
