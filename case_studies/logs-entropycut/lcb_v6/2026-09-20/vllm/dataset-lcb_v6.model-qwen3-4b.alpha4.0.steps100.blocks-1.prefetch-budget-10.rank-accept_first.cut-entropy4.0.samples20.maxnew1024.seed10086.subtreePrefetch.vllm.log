    # Precompute factorials and inverse factorials modulo MOD
    max_n = N
    fact = [1] * (max_n + 1)
    for i in range(1, max_n + 1):
        fact[i] = fact[i-1] * i % MOD
    
    inv_fact = [1] * (max_n + 1)
    inv_fact[max_n] = pow(fact[max_n], MOD-2, MOD)
    for i in range(max_n-1, -1, -1):
        inv_fact[i] = inv_fact[i+1] * (i+1) % MOD
    
    # Precompute powers of 10 modulo MOD
    power10 = [1] * (max_n + 1)
    for i in range(1, max_n + 1):
        power10[i] = power10[i-1] * 10 % MOD
    
    # For each position i (0-based or 1-based?), compute the total contribution
    # Let's consider positions from 0 to N-1 (0-based), where position i has (N - i - 1) digits to the right
    # The contribution of a digit d in position i is d * 10^{N - i - 1} * (number of times d appears in this position)
    
    # The number of times a digit d appears in position i is (number of permutations where d is in position i)
    # For each position i, the number of permutations where d is in position i is (N-1)! (since the rest can be permuted)
    # However, since we are considering all digits from 1 to N, each digit appears (N-1)! times in each position
    
    # But wait, for each position, each digit (1..N) appears exactly (N-1)! times. So for each position i, the total contribution is sum_{d=1}^N d * (N-1)! * 10^{N - i - 1}
    
    # So the total sum is sum_{i=0}^{N-1} [ (sum_{d=1}^N d) * (N-1)! * 10^{N - i - 1} ) ]
    # sum_{d=1}^N d = N*(N+1)//2
    
    total = 0
    sum_d = N * (N + 1) // 2
    for i in range(N):
        power = power10[N - i - 1]
        term = sum_d * fact[N-1] % MOD
        term = term * power % MOD
        total = (total + term) % MOD
    
    print(total)
    
