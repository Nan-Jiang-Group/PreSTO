[run_powersampling_mh_vllm] INFO: sample 7 response_length=3087 prediction=import sys
import bisect

def solve():
    # Read N from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    n = int(input_data[0])
    # Read the sizes of the N mochi
    a = list(map(int, input_data[1:]))
    
    # The problem asks for the number of pairs (i, j) such that 
    # A_i <= A_j / 2 and i != j.
    # Since the array is sorted in ascending order, A_i <= A_j / 2 
    # implies A_i < A_j, so i will always be less than j.
    
    total_kagamimochi = 0
    
    # For each mochi j (the bottom one), we want to find how many 
    # mochi i (the top one) satisfy A_i <= A_j / 2.
    # Since the array is sorted, we can use binary search (bisect_right)
    # to find the number of such mochi efficiently.
    
    for j in range(n):
        # The condition is A_i <= A_j // 2
        # bisect_right returns the leftmost insertion point that maintains order,
        # which effectively gives the count of elements <= target.
        target = a[j] // 2
        count = bisect.bisect_right(a, target)
        
        # Since A_i <= A_j / 2 and A_j >= 1, A_i must be strictly less than A_j.
        # Thus, the index i found by bisect_right will always be less than j.
        # However, if A_j is very small (e.g., 1), target is 0, and count is 0.
        # If A_j is 2, target is 1, and if A_0 is 1, count is 1.
        # The logic holds: count is the number of indices i such that A_i <= A_j/2.
        total_kagamimochi += count
        
    # Print the final result
    sys.stdout.write(str(total_kagamimochi) + '\n')

if __name__ == "__main__":
    solve() is_correct=True justification=
