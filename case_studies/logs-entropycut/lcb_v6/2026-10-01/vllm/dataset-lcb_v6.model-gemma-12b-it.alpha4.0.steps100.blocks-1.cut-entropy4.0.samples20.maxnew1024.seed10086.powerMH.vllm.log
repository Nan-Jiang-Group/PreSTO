[run_powersampling_mh_vllm] INFO: sample 12 response_length=2930 prediction=import sys

def solve():
    # Read X from standard input
    line = sys.stdin.readline()
    if not line:
        return
    x = int(line.strip())
    
    # Since X is at most 3 * 10^18, we can find N by 
    # iteratively multiplying numbers starting from 1.
    # 20! is approximately 2.4 * 10^18.
    # 21! is approximately 5.1 * 10^19.
    # So N will be small (less than 25).
    
    current_factorial = 1
    n = 1
    while current_factorial < x:
        n += 1
        current_factorial *= n
        
    print(n)

if __name__ == "__main__":
    solve() is_correct=True justification=
