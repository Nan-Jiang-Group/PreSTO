[run_powersampling_mh_vllm] INFO: sample 1 response_length=2923 prediction=import sys

# Increase recursion depth for deep DFS if necessary
sys.setrecursionlimit(3000)

def solve():
    # Read N and M
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    n = int(input_data[0])
    m = int(input_data[1])
    a = list(map(int, input_data[2:]))
    
    # The condition is x_i <= x_{A_i}.
    # This defines a directed graph where an edge i -> A_i exists.
    # If there is a cycle, all x_j in that cycle must be equal.
    # If x_i <= x_{A_i} and x_{A_i} <= x_i, then x_i = x_{A_i}.
    # We can condense the graph into Strongly Connected Components (SCCs).
    # Within each SCC, all x_i must be equal.
    # The condensed graph is a Directed Acyclic Graph (DAG).
    # If an edge exists from SCC_u to SCC_v (meaning i in SCC_u and A_i in SCC_v),
    # then x_{SCC_u} <= x_{SCC_v}.
    
    adj = [[] for _ in range(n)]
    for i in range(n):
        adj[i].append(a[i] - 1)
        
    # Tarjan's or Kosaraju's to find SCCs
    visited_time = [-1] * n
    low_link = [-1] * n
    on_stack = [False] * n
    stack = []
    timer = 0
    sccs = []
    scc_id = [-1] * n
    
    def find_sccs(u):
        nonlocal timer
        visited_time[u] = low_link[u] = timer
        timer += 1
        stack.append(u)
        on_stack[u] = True
        
        for v in adj[u]:
            if visited_time[v] == -1:
                find_sccs(v)
                low_link[u] = min(low_link[u], low_link[v])
            elif on_stack[v]:
                low_link[u] = min(low_link[u], visited_time[v])
        
        if low_link[u] == visited_time[u]:
            new_scc = []
            while True:
                node = stack.pop()
                on_stack[node] = False
                new_scc.append(node)
                scc_id[node] = len(sccs)
                if node == u:
                    break
            sccs.append(new_scc)

    for i in range(n):
        if visited_time[i] == -1:
            find_sccs(i)
            
    num_sccs = len(sccs)
    scc_adj = [set() for _ in range(num_sccs)]
    in_degree = [0] * num_sccs
    
    for u in range(n):
        v = a[u] - 1
        u_scc = scc_id[u]
        v_scc = scc_id[v]
        if u_scc != v_scc:
            if v_scc not in scc_adj[u_scc]:
                scc_adj[u_scc].add(v_scc)
                in_degree[v_scc] += 1
                
    # The problem is now: assign values 1..M to nodes in a DAG
    # such that if u -> v, then val(u) <= val(v).
    # This is equivalent to finding the number of order-preserving maps.
    # Since N, M <= 2025, we can use DP.
    # Let dp[i][j] be the number of ways to assign values to the first i 
    # nodes in topological order such that the max value is j? No, that's for chains.
    # This is a standard problem: counting linear extensions is hard, 
    # but here we need to count maps to {1..M}.
    
    # Wait, the condition is x_i <= x_{A_i}. is_correct=False justification=Code is incorrect.
