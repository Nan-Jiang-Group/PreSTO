```python
import sys

def main():
    # Read A and B
    line = sys.stdin.read().split()
    if not line:
        return
    a = int(line[0])
    b = int(line[1])
    
    # Calculate (A + B)^2
    result = (a + b) ** 2
    
    # Print result
    print(result)

if __name__ == '__main__':
    main()
```
