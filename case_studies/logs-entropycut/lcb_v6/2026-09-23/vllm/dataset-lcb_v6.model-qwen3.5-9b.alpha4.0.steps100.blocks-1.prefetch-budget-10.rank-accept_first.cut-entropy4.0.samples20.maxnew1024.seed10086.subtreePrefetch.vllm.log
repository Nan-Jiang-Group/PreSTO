```python
import sys

def solve():
    # Read all input from standard input
    input_str = sys.stdin.read().strip()
    if not input_str:
        return
    
    # Split the input string by whitespace to get A and B
    parts = input_str.split()
    A = int(parts[0])
    B = int(parts[1])
    
    # Calculate the square of A + B
    ans = (A + B) ** 2
    
    # Print the result
    print(ans)

if __name__ == '__main__':
    solve()
```
