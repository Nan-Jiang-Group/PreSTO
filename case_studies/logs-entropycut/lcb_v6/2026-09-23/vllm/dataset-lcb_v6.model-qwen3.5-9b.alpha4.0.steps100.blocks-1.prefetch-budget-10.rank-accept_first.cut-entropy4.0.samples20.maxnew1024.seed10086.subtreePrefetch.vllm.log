import sys

def solve():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
            
        # Process each k from 1 to D
        for k in range(1, D + 1):
            max_weight = 0
            for T, L in snakes:
                current_weight = T * (L + k)
                if current_weight > max_weight:
                    max_weight = current_weight
            print(max_weight)
            

