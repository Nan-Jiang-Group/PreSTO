```python
import sys

def solve():
    # Read all input from standard input
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    # Parse integers A and B
    A = int(input_data[0])
    B = int(input_data[1])
    
    # Calculate the square of A + B
    ans = (A + B) ** 2
    
    # Print the result
    print(ans)

if __name__ == '__main__':
    solve()
```
