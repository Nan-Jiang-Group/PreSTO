import math

def solve():
    # Read R from standard input
    line = sys.stdin.readline()
    if not line:
        return
    r = int(line.strip())
    
    # The problem asks for the number of integer pairs (i, j) such that
    # all four corners of the square centered at (i, j) are within distance R
    # from the origin (0, 0).
    # The corners of the square centered at (i, j) are:
    # (i+0.5, j+0.5), (i+0.5, j-0.5), (i-0.5, j+0.5), (i-0.5, j-0.5)
    #
    # A square is contained if and only if the corner furthest from the origin
    # is at a distance <= R.
    # For a square centered at (i, j), the distance of a corner (x, y) 
    # to the origin is sqrt(x^2 + y^2).
    # The condition is:
    # (i+0.5)^2 + (j+0.5)^2 <= R^2
    # (i+0.5)^2 + (j-0.5)^2 <= R^2
    # (i-0.5)^2 + (j+0.5)^2 <= R^2
    # (i-0.5)^2 + (j-0.5)^2 <= R^2
    #
    # This is equivalent to:
    # max(|i+0.5|, |i-0.5|)^2 + max(|j+0.5|, |j-0.5|)^2 <= R^2
    # Since i and j are integers:
    # max(|i+0.5|, |i-0.5|) = |i| + 0.5
    # max(|j+0.5|, |j-0.5|) = |j| + 0.5
    #
    # So we need to count (i, j) such that:
    # (|i| + 0.5)^2 + (|j| + 0.5)^2 <= R^2
    # Let x = |i| and y = |j|. x and y are non-negative integers.
    # The condition is (x + 0.5)^2 + (y + 0.5)^2 <= R^2
    # (x + 0.5)^2 + (y + 0.5)^2 <= R^2
    # x^2 + x + 0.25 + y^2 + y + 0.25 <= R^2
    # x^2 + x + y^2 + y <= R^2 - 0.5
    # Since x and y are integers, this is equivalent to:
    # x^2 + x + y^2 + y <= R^2 - 1 (if R^2 is an integer, which it is)
    # Actually, let's re-verify:
    # (x + 0.5)^2 + (y + 0.5)^2 <= R^2
    # x^2 + x + 0.25 + y^2 + y + 0.25 <= R^2
    # x^2 + x + y^2 + y <= R^2 - 0.5
    # Since x^2 + x + y^2 + y is an integer, this is equivalent to:
    # x^2 + x + y^2 + y <= floor(R^2 - 0.5)
    # Since R is an integer, R^2 - 0.5 has floor R^2 - 1.
    # Wait, if R=2, R^2-0.5 = 3.5. x^2+x+y^2+y <= 3.
    # If x=0, y=0: 0 <= 3 (True)
    # If x=1, y=0: 2 <= 3 (True)
    # If x=0, y=1: 2 <= 3 (True)
    # If x=1, y=1: 4 <= 3 (False)
    # If x=2, y=0: 6 <= 3 (False)
    # So for R=2, (x,y) pairs are (0,0), (1,0), is_correct=False justification=Code is incorrect.
