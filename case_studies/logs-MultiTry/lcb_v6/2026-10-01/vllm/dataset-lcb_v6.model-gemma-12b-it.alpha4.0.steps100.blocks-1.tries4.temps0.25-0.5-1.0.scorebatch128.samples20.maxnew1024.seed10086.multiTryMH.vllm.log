[run_powersampling_mh_vllm] INFO: sample 17 response_length=3070 prediction=import sys

def solve():
    # Read N and X
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    N = int(input_data[0])
    X = int(input_data[1])
    
    foods = []
    idx = 2
    for _ in range(N):
        v = int(input_data[idx])
        a = int(input_data[idx+1])
        c = int(input_data[idx+2])
        foods.append((v, a, c))
        idx += 3

    # Group foods by vitamin type
    v_groups = [[], [], []]
    for v, a, c in foods:
        v_groups[v-1].append((a, c))

    # We want to find the maximum K such that we can get at least K of each vitamin.
    # This can be solved by binary searching on K.
    # However, since the total calorie limit X is small (5000), 
    # we can use dynamic programming to find the minimum calories to get at least K of each.
    # But K can be large (up to 2*10^5), so we binary search K.
    
    # For a fixed K, we want to find the minimum calories to get at least K units of 
    # vitamin 1, K units of vitamin 2, and K units of vitamin 3.
    # This is a variation of the knapsack problem (minimum cost to get at least weight K).
    
    def get_min_calories(group, target_k):
        # dp[j] = minimum calories to get at least j units of this vitamin
        # Since target_k can be large, but we only care if we reach target_k,
        # we cap the index at target_k.
        dp = [float('inf')] * (target_k + 1)
        dp[0] = 0
        for a, c in group:
            for j in range(target_k, -1, -1):
                if dp[j] == float('inf'): continue
                new_a = min(target_k, j + a)
                if dp[new_a] > dp[j] + c:
                    dp[new_a] = dp[j] + c
        return dp[target_k]

    # Because the groups are independent (each food has only one vitamin type),
    # the total minimum calories for a fixed K is:
    # min_cal(group1, K) + min_cal(group2, K) + min_cal(group3, K)
    
    low = 0
    high = 200000
    ans = 0
    
    while low <= high:
        mid = (low + high) // 2
        if mid == 0:
            ans = max(ans, 0)
            low = 1
            continue
            
        c1 = get_min_calories(v_groups[0], mid)
        c2 = get_min_calories(v_groups[1], mid)
        c3 = get_min_calories(v_groups[2], mid)
        
        if c1 + c2 + c3 <= X:
            ans = mid
            low = mid + 1
        else:
            high = mid - 1
            
    print(ans)

