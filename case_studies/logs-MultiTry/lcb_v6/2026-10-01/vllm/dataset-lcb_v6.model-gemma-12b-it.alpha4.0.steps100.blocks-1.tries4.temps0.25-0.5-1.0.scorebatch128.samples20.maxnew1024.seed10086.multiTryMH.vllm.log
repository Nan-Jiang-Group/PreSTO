[run_powersampling_mh_vllm] INFO: sample 10 response_length=3449 prediction=import sys

def solve():
    """
    The problem asks for the maximum number of pairs (a, b) such that 
    a <= b/2, where each mochi is used at most once.
    
    Since the input array A is sorted in ascending order, we can use a 
    greedy approach with a two-pointer technique.
    
    We want to pair the smallest available mochi with the smallest possible 
    mochi that is at least twice its size. This ensures we leave larger 
    mochi available for other pairings.
    """
    # Read N
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    n = int(input_data[0])
    # Read A_i
    a = list(map(int, input_data[1:]))
    
    k = 0
    left = 0
    right = 1
    
    # Use two pointers to find pairs
    # 'left' points to the smaller mochi (top of kagamimochi)
    # 'right' points to the larger mochi (bottom of kagamimochi)
    while right < n:
        if a[left] * 2 <= a[right]:
            # We found a valid pair
            k += 1
            # Move both pointers to find the next pair
            left += 1
            right += 1
        else:
            # a[right] is too small to be the bottom for a[left]
            # Since a is sorted, we need a larger bottom mochi
            right += 1
            
    print(k)

if __name__ == "__main__":
    solve() is_correct=False justification=Code is incorrect.
