[run_powersampling_mh_vllm] INFO: sample 7 response_length=2972 prediction=import sys
import bisect

def solve():
    # Read all input at once for efficiency
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    n = int(input_data[0])
    a = list(map(int, input_data[1:]))
    
    # The problem asks for the number of pairs (i, j) such that 
    # A_i <= A_j / 2 and i != j.
    # Since the array is sorted in ascending order, A_i <= A_j / 2 
    # implies A_i < A_j, so i will always be less than j.
    # We need to count pairs (i, j) where 1 <= i < j <= N and A_i <= A_j / 2.
    
    total_count = 0
    
    # For each mochi j (the bottom one), we want to find how many 
    # mochi i (the top one) satisfy A_i <= A_j / 2.
    # Since the array is sorted, we can use binary search (bisect_right)
    # to find the index of the largest mochi that is <= A_j / 2.
    
    for j in range(1, n):
        target = a[j] // 2
        # bisect_right returns the insertion point which is the count of 
        # elements <= target in the range [0, j).
        count = bisect.bisect_right(a, target, 0, j)
        total_count += count
        
    print(total_count)

if __name__ == "__main__":
    solve() is_correct=True justification=
