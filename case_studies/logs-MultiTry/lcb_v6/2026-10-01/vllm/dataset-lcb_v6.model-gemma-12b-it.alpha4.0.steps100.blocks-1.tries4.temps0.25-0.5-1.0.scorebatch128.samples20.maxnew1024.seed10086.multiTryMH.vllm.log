[run_powersampling_mh_vllm] INFO: sample 19 response_length=3135 prediction=import sys

def solve():
    # Read the input from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    # Parse the sequence A
    A = [int(x) for x in input_data]
    
    # The target sorted sequence is (1, 2, 3, 4, 5)
    target = [1, 2, 3, 4, 5]
    
    # Try all possible swaps of adjacent elements
    # There are 4 possible pairs of adjacent indices: (0,1), (1,2), (2,3), (3,4)
    possible = False
    for i in range(len(A) - 1):
        # Create a copy of the sequence to perform the swap
        temp_A = list(A)
        # Swap elements at index i and i+1
        temp_A[i], temp_A[i+1] = temp_A[i+1], temp_A[i]
        
        # Check if the resulting sequence is sorted
        if temp_A == target:
            possible = True
            break
            
    # Output the result
    if possible:
        print("Yes")
    else:
        print("No")

if __name__ == "__main__":
    solve() is_correct=True justification=
