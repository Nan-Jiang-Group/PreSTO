# The problem asks to count Snake numbers between L and R.
# A Snake number is an integer >= 10 where the first digit is strictly 
# larger than every other digit.
# Let d be the first digit (1 <= d <= 9).
# If the number has k digits (k >= 2), then all other k-1 digits 
# must be in the range [0, d-1].

def solve():
    line = sys.stdin.read().split()
    if not line:
        return
    L = int(line[0])
    R = int(line[1])

    def count_snake_up_to(N):
        """Counts Snake numbers in range [10, N]"""
        if N < 10:
            return 0
        
        s_n = str(N)
        len_n = len(s_n)
        total = 0
        
        # Case 1: Numbers with fewer digits than N
        # For a fixed number of digits 'k' (2 <= k < len_n)
        # and a fixed first digit 'd' (1 <= d <= 9)
        # The number of such Snake numbers is d^(k-1)
        # However, the condition is that all other digits are < d.
        # So for a fixed d, there are d choices for each of the k-1 positions.
        # Wait, the condition is: first digit d, others are in {0, 1, ..., d-1}.
        # So there are d choices for each of the k-1 positions.
        # Total for k digits = sum_{d=1}^9 d^(k-1)
        for k in range(2, len_n):
            for d in range(1, 10):
                total += d**(k-1)
        
        # Case 2: Numbers with the same number of digits as N
        # Let the first digit of N be D.
        # For first digit d < D:
        # All d in {1, ..., D-1} are valid first digits.
        # For each d, there are d^(len_n - 1) such numbers.
        first_digit_n = int(s_n[0])
        for d in range(1, first_digit_n):
            total += d**(len_n - 1)
            
        # For first digit d == D:
        # We need to count numbers of length len_n starting with D
        # such that all subsequent digits are < D and the number <= N.
        # This is a digit DP style approach or a recursive count.
        
        def count_with_fixed_prefix(prefix_str, max_val_str, max_digit):
            # Counts numbers of length len_n starting with prefix_str
            # where all digits are < max_digit and number <= max_val_str
            # This is slightly complex. Let's simplify.
            pass

        # Let's use a simpler approach for the same length:
        # We want to count numbers X = D x_1 x_2 ... x_{k-1}
        # such that 0 <= x_i < D and X <= N.
        # This is equivalent to counting sequences (x_1, ..., x_{k-1})
        # where each x_i \in {0, ..., D-1} and the number formed is <= N.
        
        # Let's use digit DP logic for the remaining k-1 positions.
        # dp(index, is_less)
        memo = {}
        def count_recursive(idx, is_less):
            state = (idx, is_less)
            if state in memo: return memo[state]
            
            if idx == len_n:
                return 1
            
            res = 0
            limit = int(s_n[idx]) if not is_less else first_digit_n - 1
            # The digit at idx must be < first_digit_n
            # and if is_less is false, it must be <= s_n[idx]
            upper = min(limit, first_digit_n - 1)
            
            for digit in range(upper + 1):
                new_is_less = is_less or (digit < limit)
                res += count_recursive(idx + 1, new_is_less)
            
            memo[state] = is_correct=False justification=Code is incorrect.
