# Increase recursion depth for deep DFS if necessary
sys.setrecursionlimit(3000)

def solve():
    # Read N and M
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    N = int(input_data[0])
    M = int(input_data[1])
    A = list(map(int, input_data[2:]))
    
    # The condition is x_i <= x_{A_i}.
    # This defines a directed graph where an edge exists from i to A_i.
    # If there is a cycle in this graph, all elements in that cycle must be equal.
    # If x_i <= x_{A_i} and x_{A_i} <= x_i, then x_i = x_{A_i}.
    
    # Let's represent the dependencies as a directed graph.
    # x_i <= x_{A_i} means x_i is constrained by x_{A_i}.
    adj = [[] for _ in range(N + 1)]
    for i, a_i in enumerate(A, 1):
        adj[i].append(a_i)
        
    # Find Strongly Connected Components (SCCs)
    # Elements in the same SCC must have the same value.
    visited_time = [0] * (N + 1)
    low_link = [0] * (N + 1)
    stack = []
    on_stack = [False] * (N + 1)
    timer = 0
    sccs = []
    
    def find_sccs(u):
        nonlocal timer
        timer += 1
        visited_time[u] = low_link[u] = timer
        stack.append(u)
        on_stack[u] = True
        
        for v in adj[u]:
            if visited_time[v] == 0:
                find_sccs(v)
                low_link[u] = min(low_link[u], low_link[v])
            elif on_stack[v]:
                low_link[u] = min(low_link[u], visited_time[v])
        
        if low_link[u] == visited_time[u]:
            component = []
            while True:
                node = stack.pop()
                on_stack[node] = False
                component.append(node)
                if node == u:
                    break
            sccs.append(component)

    for i in range(1, N + 1):
        if visited_time[i] == 0:
            find_sccs(i)
            
    # Condense the graph into a DAG of SCCs
    scc_id = [0] * (N + 1)
    for idx, component in enumerate(sccs):
        for node in component:
            scc_id[node] = idx + 1
            
    num_sccs = len(sccs)
    scc_adj = [set() for _ in range(num_sccs + 1)]
    in_degree = [0] * (num_sccs + 1)
    
    for u in range(1, N + 1):
        for v in adj[u]:
            if scc_id[u] != scc_id[v]:
                if scc_id[v] not in scc_adj[scc_id[u]]:
                    scc_adj[scc_id[u]].add(scc_id[v])
                    in_degree[scc_id[v]] += 1
                    
    # The condition x_i <= x_{A_i} translates to:
    # If there is an edge from SCC_u to SCC_v, then value(SCC_u) <= value(SCC_v).
    # This is a standard problem: count number of ways to assign values 1..M 
    # to nodes of a DAG such that if u -> v, val(u) <= val(v).
    
    # Since N, M <= 2025, we can use DP.
    # Let dp[u][v] be the number of ways to assign values to the subtree rooted at u
    # such that val(u) = v. However, this is a DAG, not a tree. is_correct=False justification=Code is incorrect.
