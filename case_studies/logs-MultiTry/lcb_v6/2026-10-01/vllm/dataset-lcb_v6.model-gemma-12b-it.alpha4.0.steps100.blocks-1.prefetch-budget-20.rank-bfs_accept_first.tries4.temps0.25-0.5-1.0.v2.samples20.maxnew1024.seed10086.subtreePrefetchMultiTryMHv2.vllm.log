[run_powersampling_mh_vllm] INFO: sample 1 response_length=3428 prediction=import sys

# Increase recursion depth for deep DFS if necessary
sys.setrecursionlimit(3000)

def solve():
    # Read N and M
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    n = int(input_data[0])
    m = int(input_data[1])
    a = list(map(int, input_data[2:]))
    
    # The condition is x_i <= x_{A_i}.
    # This defines a directed graph where an edge i -> A_i exists.
    # If there is a cycle, all elements in that cycle must be equal.
    # If x_i <= x_{A_i} and x_{A_i} <= x_i, then x_i = x_{A_i}.
    
    # Let's find the Strongly Connected Components (SCCs).
    # All elements in an SCC must have the same value.
    # Let the SCCs be nodes in a new DAG.
    # If there is an edge i -> A_i in the original graph, 
    # and i is in SCC_u and A_i is in SCC_v, then x(SCC_u) <= x(SCC_v).
    
    adj = [[] for _ in range(n)]
    for i, val in enumerate(a):
        # i is 0-indexed, val is 1-indexed
        adj[i].append(val - 1)
        
    # Tarjan's or Kosaraju's to find SCCs
    visited_time = [-1] * n
    low_link = [-1] * n
    on_stack = [False] * n
    stack = []
    timer = 0
    sccs = []
    scc_id = [-1] * n
    
    def find_sccs():
        nonlocal timer
        for i in range(n):
            if visited_time[i] == -1:
