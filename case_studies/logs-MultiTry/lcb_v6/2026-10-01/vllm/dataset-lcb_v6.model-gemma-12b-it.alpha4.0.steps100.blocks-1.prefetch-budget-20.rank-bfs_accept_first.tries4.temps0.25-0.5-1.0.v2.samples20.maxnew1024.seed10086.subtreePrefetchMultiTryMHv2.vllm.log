import bisect

def solve():
    # Read N from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    n = int(input_data[0])
    # Read the sizes of the N mochi
    a = list(map(int, input_data[1:]))
    
    # We want to find the maximum number of pairs (a_i, a_j) such that
    # a_i <= a_j / 2 and each mochi is used at most once.
    # This is a classic greedy matching problem.
    # To maximize the number of pairs, we should try to pair the smallest
    # available mochi with the smallest possible mochi that is at least twice its size.
    
    # However, a more standard greedy approach for this specific constraint (a_i <= a_j/2)
    # is to iterate through the mochi from largest to smallest and pair each mochi
    # with the largest available mochi that is at most half its size.
    # Alternatively, iterate from smallest to largest and pair each mochi 
    # with the smallest available mochi that is at least twice its size.
    
    # Let's use the second approach:
    # For each mochi (from smallest to largest), if it hasn't been used as a 
    # "bottom" mochi, try to find the smallest "bottom" mochi that can 
    # support it. Wait, that's slightly confusing.
    
    # Let's re-simplify: We want to pair a small mochi with a large mochi.
    # To maximize pairs, we should pick the smallest available mochi and 
    # pair it with the smallest available mochi that is >= 2 * its size.
    
    count = 0
    used = [False] * n
    # Since we need to efficiently find and "remove" elements, 
    # and the array is sorted, we can use a two-pointer approach or a queue.
    
    # Let's use a two-pointer approach:
    # Pointer 'i' points to the small mochi (top).
    # Pointer 'j' points to the large mochi (bottom).
    i = 0
    j = 0
    while i < n and j < n:
        if a[i] * 2 <= a[j]:
            # We found a pair: a[i] is top, a[j] is bottom.
            count += 1
            i += 1
            j += 1
        else:
            # a[j] is too small to be a bottom for a[i].
            # Since we want to pair a[i] with something, and a[j] is too small,
            # we move j forward to find a larger bottom.
            j += 1
            
    print(count)

