[run_powersampling_mh_vllm] INFO: sample 19 response_length=3256 prediction=import sys

def solve():
    # Read input from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    # Convert input to a list of integers
    a = [int(x) for x in input_data]
    
    # The target sorted sequence
    target = [1, 2, 3, 4, 5]
    
    # Try all possible swaps of adjacent elements
    # There are 4 possible pairs of adjacent indices: (0,1), (1,2), (2,3), (3,4)
    possible = False
    for i in range(len(a) - 1):
        # Create a copy of the current sequence
        b = list(a)
        # Swap adjacent elements at index i and i+1
        b[i], b[i+1] = b[i+1], b[i]
        
        # Check if the resulting sequence is sorted
        if b == target:
            possible = True
            break
            
    # Output the result
    if possible:
        print("Yes")
    else:
        print("No")

if __name__ == "__main__":
    solve() is_correct=True justification=
