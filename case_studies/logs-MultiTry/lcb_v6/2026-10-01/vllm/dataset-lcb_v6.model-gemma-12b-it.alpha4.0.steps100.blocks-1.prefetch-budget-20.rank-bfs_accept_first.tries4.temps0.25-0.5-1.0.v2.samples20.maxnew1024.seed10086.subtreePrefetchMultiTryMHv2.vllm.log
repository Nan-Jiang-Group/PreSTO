[run_powersampling_mh_vllm] INFO: sample 17 response_length=2930 prediction=import sys

def solve():
    # Read N and X
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    N = int(input_data[0])
    X = int(input_data[1])
    
    # Group foods by vitamin type
    foods = [[], [], []]
    idx = 2
    for _ in range(N):
        v = int(input_data[idx])
        a = int(input_data[idx+1])
        c = int(input_data[idx+2])
        foods[v-1].append((a, c))
        idx += 3
        
    # Precompute DP for each vitamin type
    # dp[v][c] = max amount of vitamin v we can get with exactly c calories
    # Or rather, min calories to get at least 'amount' of vitamin.
    # Since we want to maximize the minimum, let's use:
    # min_calories[v][amount] = minimum calories to get at least 'amount' of vitamin v.
    
    # However, the values of A_i are large (up to 2*10^5), but X is small (up to 5000).
    # Let's use dp[v][calories] = max amount of vitamin v.
    
    def get_max_amounts(food_list, max_x):
        # dp[c] is the max amount of vitamin for c calories
        dp = [0] * (max_x + 1)
        for a, c in food_list:
            for j in range(max_x, c - 1, -1):
                if dp[j - c] + a > dp[j]:
                    dp[j] = dp[j - c] + a
        # Make dp[c] non-decreasing: max amount for AT MOST c calories
        for j in range(1, max_x + 1):
            if dp[j-1] > dp[j]:
                dp[j] = dp[j-1]
        return dp

    dp1 = get_max_amounts(foods[0], X)
    dp2 = get_max_amounts(foods[1], X)
    dp3 = get_max_amounts(foods[2], X)

    # We want to find max K such that there exist c1, c2, c3 with c1+c2+c3 <= X
    # and dp1[c1] >= K, dp2[c2] >= K, dp3[c3] >= K.
    
    # To do this efficiently, for each vitamin, find the min calories to get at least K.
    # Let min_c[v][K] be the smallest c such that dp_v[c] >= K.
    
    # Because A_i is large, K can be large. But we only care about K values 
    # that are actually achievable.
    # Actually, we can binary search for K.
    
    def check(K):
        # Find minimum calories to get at least K for each vitamin
        min_c1 = -1
        for c in range(X + 1):
            if dp1[c] >= K:
                min_c1 = c
                break
        if min_c1 == -1: return False
        
        min_c2 = -1
        for c in range(X + 1):
            if dp2[c] >= K:
                min_c2 = c
                break
        if min_c2 == -1: return False
        
        min_c3 = -1
        for c in range(X + 1):
            if dp3[c] >= K:
                min_c3 = c
                break
        if min_c3 == -1: return False
        
        return (min_c1 + min_c2 + min_c3) <= X

    # Binary search for the maximum K
    # What is the maximum possible K? 
    # Sum of A_i can be 5000 * 200,000 = 10^9.
    low = 0
    high = 10**9
    ans = 0
    
    while low <= high:
        mid = (low + high) // 2
        if check(mid):
            ans = mid is_correct=False justification=Code is incorrect.
