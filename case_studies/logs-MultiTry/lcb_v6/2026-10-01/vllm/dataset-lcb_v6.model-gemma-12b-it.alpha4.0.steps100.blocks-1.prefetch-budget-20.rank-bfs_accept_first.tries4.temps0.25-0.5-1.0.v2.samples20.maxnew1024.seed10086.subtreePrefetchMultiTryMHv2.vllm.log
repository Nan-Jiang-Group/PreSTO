[run_powersampling_mh_vllm] INFO: sample 7 response_length=3144 prediction=import sys
import bisect

def solve():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    n = int(input_data[0])
    a = list(map(int, input_data[1:]))
    
    # The problem asks for the number of pairs (i, j) such that 
    # A_i <= A_j / 2 and i != j.
    # Since the array is sorted in ascending order, A_i <= A_j / 2 
    # implies A_i < A_j, so i will always be less than j.
    
    total_count = 0
    
    # For each mochi j (acting as the bottom mochi), we need to find
    # how many mochi i (acting as the top mochi) satisfy A_i <= A_j / 2.
    # Because the array is sorted, we can use binary search to find the 
    # rightmost index i such that A_i <= A_j // 2.
    
    for j in range(n):
        bottom_size = a[j]
        max_top_size = bottom_size // 2
        
        # bisect_right returns the insertion point which is the index 
        # of the first element strictly greater than max_top_size.
        # All elements before this index satisfy the condition.
        count = bisect.bisect_right(a, max_top_size)
        total_count += count
        
    # Output the total count
    sys.stdout.write(str(total_count) + '\n')

if __name__ == "__main__":
    solve() is_correct=True justification=
