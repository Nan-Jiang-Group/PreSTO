[run_powersampling_mh_vllm] INFO: sample 16 response_length=2584 prediction=import sys

def solve():
    # Read N and M
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    n = int(input_data[0])
    m = int(input_data[1])
    p = list(map(int, input_data[2:]))
    
    # The problem asks for the maximum total units K such that
    # Sum(k_i^2 * P_i) <= M, where Sum(k_i) = K.
    # To minimize Sum(k_i^2 * P_i) for a fixed K, we should distribute
    # the units among products such that the marginal cost of adding one 
    # more unit to any product is as small as possible.
    # The cost of increasing k_i to k_i + 1 is (k_i + 1)^2 * P_i - k_i^2 * P_i
    # = (2*k_i + 1) * P_i.
    
    # However, we can use a binary search on the total number of units K.
    # For a fixed K, we want to minimize Sum(k_i^2 * P_i) subject to Sum(k_i) = K.
    # Using Lagrange multipliers (discrete version), the optimal distribution
    # occurs when (2*k_i + 1) * P_i is roughly equal for all products.
    # Specifically, there exists a threshold value X such that for each i,
    # we choose k_i such that (2*k_i - 1) * P_i < X and (2*k_i + 1) * P_i >= X.
    # Wait, the marginal cost of the k_i-th unit is (2*k_i - 1) * P_i.
    # Let's re-evaluate:
    # Cost of k_i units: k_i^2 * P_i.
    # Cost of k_i + 1 units: (k_i + 1)^2 * P_i.
    # Marginal cost of the (k_i + 1)-th unit: (2*k_i + 1) * P_i.
    # The 1st unit (k_i=1) costs 1^2 * P_i - 0^2 * P_i = 1 * P_i.
    # The 2nd unit (k_i=2) costs 2^2 * P_i - 1^2 * P_i = 3 * P_i.
    # The j-th unit costs (2j - 1) * P_i.
    
    # For a fixed threshold X, the number of units k_i we can buy for product i
    # such that every unit costs <= X is the largest k_i such that (2*k_i - 1) * P_i <= X.
    # (2*k_i - 1) <= X / P_i  =>  2*k_i <= X / P_i + 1  =>  k_i = floor((X / P_i + 1) / 2).
    
    def get_total_cost_and_units(X):
        total_units = 0
        total_cost = 0
        for pi in p:
            # k_i is the largest integer such that (2*k_i - 1) * pi <= X
            # 2*k_i - 1 <= X // pi
            # 2*k_i <= (X // pi) + 1
            ki = (X // pi + 1) // 2
            total_units += ki
            total_cost += ki * ki * pi
        return total_units, total_cost

    # Binary search for the threshold X
    # X can range from 0 to 2 * 10^18 (since M is 10^18 and P_i >= 1)
    low = 0
    high = 4 * 10**18 # Sufficiently large
    best_X = 0
    
    while low <= high:
        mid = (low + high) // 2
        units, cost = get_total_cost_and_units(mid)
        if cost <= m:
            best_X = mid
            low = mid + 1 is_correct=False justification=Code is incorrect.
