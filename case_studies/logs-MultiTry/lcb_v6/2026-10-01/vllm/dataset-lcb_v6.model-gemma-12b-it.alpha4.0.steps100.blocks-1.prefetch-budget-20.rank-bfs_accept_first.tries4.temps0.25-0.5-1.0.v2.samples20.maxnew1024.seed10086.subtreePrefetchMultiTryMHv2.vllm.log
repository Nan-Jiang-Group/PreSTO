[run_powersampling_mh_vllm] INFO: sample 5 response_length=3213 prediction=import sys

def solve():
    # Read all input from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    # Parse N and D
    N = int(input_data[0])
    D = int(input_data[1])
    
    snakes = []
    idx = 2
    for _ in range(N):
        T = int(input_data[idx])
        L = int(input_data[idx+1])
        snakes.append((T, L))
        idx += 2
        
    # For each k from 1 to D
    for k in range(1, D + 1):
        max_weight = -1
        # Calculate weight for each snake with increased length
        for T, L in snakes:
            current_weight = T * (L + k)
            if current_weight > max_weight:
                max_weight = current_weight
        # Print the maximum weight for the current k
        print(max_weight)

if __name__ == "__main__":
    solve() is_correct=True justification=
