import sys

def solve():
    # Read R from standard input
    line = sys.stdin.readline()
    if not line:
        return
    r = int(line.strip())
    
    # The problem asks for the number of integer pairs (i, j) such that
    # all four corners of the square centered at (i, j) are within distance R
    # from the origin (0, 0).
    # The corners of the square centered at (i, j) are:
    # (i+0.5, j+0.5), (i+0.5, j-0.5), (i-0.5, j+0.5), (i-0.5, j-0.5)
    #
    # For a square to be completely contained, the distance from the origin 
    # to the corner furthest from the origin must be <= R.
    # The distance squared of a corner (x, y) is x^2 + y^2.
    # For a square centered at (i, j), the maximum distance squared is:
    # max((|i|+0.5)^2 + (|j|+0.5)^2)
    #
    # Let x = |i| and y = |j|. The condition is:
    # (x + 0.5)^2 + (y + 0.5)^2 <= R^2
    # (x + 0.5)^2 + (y + 0.5)^2 <= R^2
    # x^2 + x + 0.25 + y^2 + y + 0.25 <= R^2
    # x^2 + x + y^2 + y <= R^2 - 0.5
    # Since x and y are integers, this is equivalent to:
    # x^2 + x + y^2 + y <= R^2 - 1 (because R^2 - 0.5 is between R^2-1 and R^2)
    # Wait, let's re-evaluate:
    # (x + 0.5)^2 + (y + 0.5)^2 <= R^2
    # x^2 + x + 0.25 + y^2 + y + 0.25 <= R^2
    # x^2 + x + y^2 + y <= R^2 - 0.5
    # Since x, y are integers, x^2 + x + y^2 + y is always an integer.
    # Thus, x^2 + x + y^2 + y <= floor(R^2 - 0.5)
    # If R is an integer, R^2 - 0.5 floor is R^2 - 1.
    # Let's check Sample 1: R=2. R^2-1 = 3.
    # x=0, y=0: 0+0+0+0 = 0 <= 3 (True)
    # x=1, y=0: 1+1+0+0 = 2 <= 3 (True)
    # x=0, y=1: 0+0+1+1 = 2 <= 3 (True)
    # x=1, y=1: 1+1+1+1 = 4 <= 3 (False)
    # x=2, y=0: 4+2+0+0 = 6 <= 3 (False)
    # For x=0, y=0: 1 square (i=0, j=0)
    # For x=1, y=0: 2 squares (i=1, j=0 and i=-1, j=0)
    # For x=0, y=1: 2 squares (i=0, j=1 and i=0, j=-1)
    # Total = 1 + 2 + 2 = 5. Correct.
    
    # Let's check Sample 2: R=4. R^2-1 = 15.
    # x=0: y^2+y <= 15 => y=0,1,2,3 (4 values)
    # x=1: y^2+y <= 13 => y=0,1,2,3 (4 values)
    # x=2: y^2+y <= 9  => y=0,1,2 (3 values)
    # x=3: y is_correct=False justification=Code is incorrect.
