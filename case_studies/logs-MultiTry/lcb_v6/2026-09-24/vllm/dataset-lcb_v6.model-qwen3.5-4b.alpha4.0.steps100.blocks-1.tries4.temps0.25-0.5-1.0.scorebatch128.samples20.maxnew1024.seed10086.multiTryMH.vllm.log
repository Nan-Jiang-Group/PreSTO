[run_powersampling_mh_vllm] INFO: sample 5 response_length=2539 prediction=import sys

def solve():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
            
        # Process for each k from 1 to D
        for k in range(1, D + 1):
            max_weight = -1
            for t, l in snakes:
                current_weight = t * (l + k)
                if current_weight > max_weight:
                    max_weight = current_weight
            print(max_weight)
            
    except StopIteration:
        pass

if __name__ == '__main__':
    solve() is_correct=True justification=
