[run_powersampling_mh_vllm] INFO: sample 17 response_length=3155 prediction=import sys

def solve():
    # Read N and X
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    N = int(input_data[0])
    X = int(input_data[1])
    
    # Group foods by vitamin type
    # foods[v] = list of (amount, calories)
    foods = {1: [], 2: [], 3: []}
    idx = 2
    for _ in range(N):
        v = int(input_data[idx])
        a = int(input_data[idx+1])
        c = int(input_data[idx+2])
        foods[v].append((a, c))
        idx += 3

    # We want to find max K such that we can get at least K of each vitamin
    # with total calories <= X.
    # This is a variation of the knapsack problem.
    # Since we need to satisfy 3 independent vitamin requirements, 
    # let's find the minimum calories to get at least K units for each vitamin type.
    
    def get_min_calories(items, target_k):
        # Standard 0/1 knapsack to find min calories to get at least target_k
        # dp[j] = min calories to get at least j units of this vitamin
        # Max possible units we might need to track is target_k
        dp = [float('inf')] * (target_k + 1)
        dp[0] = 0
        for amount, calories in items:
            for j in range(target_k, -1, -1):
                if dp[j] == float('inf'):
                    continue
                new_amt = min(target_k, j + amount)
                if dp[new_amt] > dp[j] + calories:
                    dp[new_amt] = dp[j] + calories
        return dp[target_k]

    # Binary search for the answer K
    # The maximum possible value for K is (N * max(A_i)) / 3, 
    # but practically it's bounded by the sum of A_i for a vitamin type.
    # A safe upper bound is sum of all A_i.
    low = 0
    high = 200000 * N // 3 + 1
    ans = 0
    
    # Optimization: The maximum possible K is limited by the sum of A_i 
    # for each vitamin type.
    max_possible_k = min(sum(f[0] for f in foods[1]), 
                           sum(f[0] for f in foods[2]), 
                           sum(f[0] for f in foods[3]))
    
    high = max_possible_k
    
    while low <= high:
        mid = (low + high) // 2
        if mid == 0:
            ans = max(ans, 0)
            low = mid + 1
            continue
            
        c1 = get_min_calories(foods[1], mid)
        if c1 > X:
            high = mid - 1
            continue
            
        c2 = get_min_calories(foods[2], mid)
        if c1 + c2 > X:
            high = mid - 1
            continue
            
        c3 = get_min_calories(foods[3], mid)
        if c1 + c2 + c3 <= X:
            ans = mid
            low = mid + 1
        else:
            high = mid - 1
            
    print(ans)

if __name__ == "__main__":
    solve() is_correct=False justification=Code is incorrect.
