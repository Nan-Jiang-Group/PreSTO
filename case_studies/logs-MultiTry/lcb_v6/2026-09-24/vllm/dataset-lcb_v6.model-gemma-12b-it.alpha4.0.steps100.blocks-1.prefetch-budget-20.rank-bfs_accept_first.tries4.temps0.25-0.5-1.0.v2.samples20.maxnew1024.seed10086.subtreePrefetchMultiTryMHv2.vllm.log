    p = list(map(int, input_data[2:]))

    # The cost function is f(k_1, ..., k_n) = sum(k_i^2 * P_i)
    # We want to maximize sum(k_i) subject to sum(k_i^2 * P_i) <= M.
    # This is a convex optimization problem. For a fixed total sum K,
    # the minimum cost is achieved when the marginal costs are as balanced as possible.
    # The marginal cost of increasing k_i to k_i + 1 is (k_i + 1)^2 * P_i - k_i^2 * P_i
    # which is (2*k_i + 1) * P_i.
    
    # We can binary search for the total number of units K.
    # For a fixed K, we want to find k_i such that sum(k_i) = K and sum(k_i^2 * P_i) is minimized.
    # This happens when (2*k_i + 1) * P_i is roughly the same for all i.
    # Let lambda be the threshold such that (2*k_i + 1) * P_i <= lambda.
    # Then k_i = floor((lambda / P_i - 1) / 2).
    # Since k_i must be non-negative, k_i = max(0, floor((lambda / P_i - 1) / 2)).
    # Actually, it's easier to think: k_i is the largest integer such that (2*k_i - 1) * P_i <= lambda.
    # Wait, the marginal cost of the j-th unit of product i is (2j-1) * P_i.
    # We want to pick the K smallest marginal costs across all products.
    
    def get_min_cost(K):
        # We need to find a lambda such that sum(k_i) = K
        # where k_i is the number of units of product i such that (2*k_i - 1) * P_i <= lambda.
        # k_i = floor((lambda / P_i + 1) / 2) is not quite right.
        # Let's use: k_i is the largest integer such that (2*k_i - 1) * P_i <= lambda.
        # If lambda < P_i, k_i = 0.
        # Otherwise, 2*k_i - 1 <= lambda / P_i  => 2*k_i <= lambda / P_i + 1 => k_i = floor((lambda / P_i + 1) / 2).
        
        # Binary search for lambda
        low_l = 0
        high_l = 2 * 10**18 # Sufficiently large
        best_lambda = high_l
        
        while low_l <= high_l:
            mid = (low_l + high_l) // 2
            total_k = 0
            for val in p:
                total_k += (mid // val + 1) // 2
            if total_k >= K:
                best_lambda = mid
                high_l = mid - 1
            else:
                low_l = mid + 1
        
        # With best_lambda, we might have sum(k_i) > K.
        # We need to reduce some k_i such that sum(k_i) = K and cost is minimized.
        # The units we "over-bought" are those where (2*k_i - 1) * P_i == best_lambda.
        current_k = []
        total_count = 0
        total_cost = 0
        for val in p:
            ki = (best_lambda // val + 1) // 2
            current_k.append(ki)
            total_count += ki
            total_cost += ki * ki * val
            
