[run_powersampling_mh_vllm] INFO: sample 10 response_length=3440 prediction=import sys

def solve():
    # Read all input from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    # First element is N, the number of mochi
    n = int(input_data[0])
    # The rest are the sizes of the mochi in ascending order
    a = list(map(int, input_data[1:]))
    
    # To maximize the number of kagamimochi (pairs), we use a greedy approach.
    # We want to pair the smallest available mochi with the smallest possible 
    # mochi that is at least twice its size.
    
    count = 0
    left = 0
    right = 0
    
    # Two-pointer approach:
    # 'left' points to the mochi we are trying to place on top.
    # 'right' points to the mochi we are considering as the base.
    while left < n and right < n:
        # If the mochi at 'right' can serve as a base for the mochi at 'left'
        if a[right] >= 2 * a[left]:
            # We form a kagamimochi
            count += 1
            # Move both pointers as these mochi are now used
            left += 1
            right += 1
        else:
            # The mochi at 'right' is too small to be a base for 'left'.
            # Since the array is sorted, we must look for a larger base.
            right += 1
            
    # Print the total count of kagamimochi formed
    print(count)

if __name__ == "__main__":
    solve() is_correct=False justification=Code is incorrect.
