[run_powersampling_mh_vllm] INFO: sample 5 response_length=771 prediction=import sys

def solve():
    # Read N and D from the first line
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    N = int(input_data[0])
    D = int(input_data[1])
    
    snakes = []
    idx = 2
    for _ in range(N):
        T = int(input_data[idx])
        L = int(input_data[idx+1])
        snakes.append((T, L))
        idx += 2
        
    # For each k from 1 to D
    for k in range(1, D + 1):
        max_weight = -1
        for T, L in snakes:
            # Calculate weight: thickness * (original_length + k)
            current_weight = T * (L + k)
            if current_weight > max_weight:
                max_weight = current_weight
        print(max_weight)

if __name__ == "__main__":
    solve() is_correct=True justification=
