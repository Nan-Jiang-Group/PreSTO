[run_powersampling_mh_vllm] INFO: sample 19 response_length=3336 prediction=import sys

def solve():
    # Read the input from standard input
    try:
        line = sys.stdin.readline()
        if not line:
            return
        a = list(map(int, line.split()))
    except ValueError:
        return

    # The goal is to see if exactly one swap of adjacent elements
    # results in the sorted sequence (1, 2, 3, 4, 5).
    
    target = [1, 2, 3, 4, 5]
    possible = False
    
    # Iterate through all possible adjacent swaps
    # There are 4 possible pairs of adjacent indices: (0,1), (1,2), (2,3), (3,4)
    for i in range(len(a) - 1):
        # Create a copy of the current sequence
        temp_a = list(a)
        
        # Perform the swap
        temp_a[i], temp_a[i+1] = temp_a[i+1], temp_a[i]
        
        # Check if the resulting sequence is sorted
        if temp_a == target:
            possible = True
            break
            
    if possible:
        print("Yes")
    else:
        print("No")

if __name__ == "__main__":
    solve() is_correct=True justification=
