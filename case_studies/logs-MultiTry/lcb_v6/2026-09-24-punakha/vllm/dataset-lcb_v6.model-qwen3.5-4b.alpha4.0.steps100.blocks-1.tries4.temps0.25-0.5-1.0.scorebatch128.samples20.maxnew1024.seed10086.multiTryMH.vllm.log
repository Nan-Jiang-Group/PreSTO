def solve():
    # Reading input from stdin
    # The input format is "A B"
    try:
        line = sys.stdin.read()
        if not line:
            return
        parts = line.split()
        if len(parts) < 2:
            return
        a = int(parts[0])
        b = int(parts[1])
        
        # Calculating (A + B)^2
        ans = (a + b) ** 2
        
        # Writing output to stdout
        print(ans)
    except Exception:
        pass

if __name__ == "__main__":
    solve() is_correct=True justification=
