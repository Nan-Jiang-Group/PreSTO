        D = int(next(iterator))
        
        snakes = []
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
            
        for k in range(1, D + 1):
            max_weight = 0
            for t, l in snakes:
                weight = t * (l + k)
                if weight > max_weight:
                    max_weight = weight
            print(max_weight)
            
    except StopIteration:
        pass

