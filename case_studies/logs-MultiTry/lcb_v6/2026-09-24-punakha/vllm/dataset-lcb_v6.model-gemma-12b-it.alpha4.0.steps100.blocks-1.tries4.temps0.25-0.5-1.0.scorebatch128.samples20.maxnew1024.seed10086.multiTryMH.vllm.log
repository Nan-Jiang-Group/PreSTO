    input_data = sys.stdin.read().split()
    if not input_data:
        return
    x = int(input_data[0])
    
    total_sum = 0
    # Iterate through the 9x9 multiplication table
    for i in range(1, 10):
        for j in range(1, 10):
            val = i * j
            # If the value in the cell is not X, add it to the total sum
            if val != x:
                total_sum += val
                
    # Print the final sum to stdout
    print(total_sum)

if __name__ == "__main__":
    solve() is_correct=True justification=
