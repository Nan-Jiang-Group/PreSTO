# The problem asks to count Snake numbers between L and R.
# A Snake number is an integer >= 10 where the first digit is strictly 
# larger than every other digit.
# Let d be the first digit (1 <= d <= 9).
# The remaining digits must be in the range [0, d-1].
# If the number has k digits in total, the first digit is fixed, 
# and there are (d) choices for each of the remaining (k-1) positions.
# So for a fixed length k and first digit d, there are d^(k-1) such numbers.

def count_snake_up_to(N_str):
    """Counts Snake numbers in the range [10, N] inclusive."""
    if not N_str or int(N_str) < 10:
        return 0
    
    n = len(N_str)
    total = 0
    
    # 1. Count all Snake numbers with fewer digits than N
    # For length i (from 2 to n-1):
    # For each first digit d (from 1 to 9):
    # There are d^(i-1) Snake numbers.
    for i in range(2, n):
        for d in range(1, 10):
            total += d**(i-1)
            
    # 2. Count Snake numbers with exactly n digits that are <= N
    # Let the first digit of N be D.
    D = int(N_str[0])
    
    # For first digits d < D:
    # All numbers of length n starting with d are Snake numbers.
    # There are d^(n-1) such numbers.
    for d in range(1, D):
        total += d**(n-1)
        
    # For first digit d == D:
    # We need to count numbers of length n starting with D where 
    # all subsequent digits are < D and the number <= N.
    # This is a digit DP style approach or a recursive counting.
    
    # Let's use a recursive function with memoization to count 
    # numbers of length n starting with D such that all digits < D 
    # and the number <= N.
    
    memo = {}

    def count_recursive(idx, is_less, current_num_str):
        state = (idx, is_less)
        if state in memo:
            return memo[state]
        
        if idx == n:
            return 1
        
        res = 0
        limit = int(N_str[idx]) if not is_less else D - 1
        
        # The digits must be strictly less than D.
        # However, if is_less is true, the limit is D-1.
        # If is_less is false, the limit is min(limit, D-1).
        upper = min(limit, D - 1)
        
        for digit in range(upper + 1):
            new_is_less = is_less or (digit < limit)
            res += count_recursive(idx + 1, new_is_less, "")
            
        memo[state] = res
        return res

    # Special case: The first digit is already fixed as D.
    # We start from index 1.
    # The condition is: all digits at indices [1, n-1] must be < D.
    # And the resulting number must be <= N.
    
    # To handle the "strictly less than D" constraint easily:
    # A number is Snake if all digits are < D.
    # We want to count how many such numbers are <= N.
    
