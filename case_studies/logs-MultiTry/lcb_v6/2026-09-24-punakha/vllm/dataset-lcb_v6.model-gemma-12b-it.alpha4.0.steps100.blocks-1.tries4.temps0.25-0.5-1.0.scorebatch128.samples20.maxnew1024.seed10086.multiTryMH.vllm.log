[run_powersampling_mh_vllm] INFO: sample 1 response_length=2951 prediction=import sys

# Increase recursion depth for deep DFS/graphs
sys.setrecursionlimit(3000)

def solve():
    # Read N and M
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    N = int(input_data[0])
    M = int(input_data[1])
    A = list(map(int, input_data[2:]))
    
    # The condition is x_i <= x_{A_i}.
    # This defines a directed graph where an edge i -> A_i exists.
    # If there is a cycle in this graph, all elements in that cycle 
    # must be equal because x_i <= x_{A_i} <= x_{A_{A_i}} ... <= x_i.
    
    # Step 1: Condense the graph into Strongly Connected Components (SCCs).
    # All elements in an SCC must have the same value.
