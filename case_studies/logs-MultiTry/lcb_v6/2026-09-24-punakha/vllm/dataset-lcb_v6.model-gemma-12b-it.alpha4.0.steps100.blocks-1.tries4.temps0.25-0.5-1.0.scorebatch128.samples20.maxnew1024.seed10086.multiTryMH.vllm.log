[run_powersampling_mh_vllm] INFO: sample 9 response_length=3026 prediction=import sys

def solve():
    # Read N, M, A, B
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    N = int(input_data[0])
    M = int(input_data[1])
    A = int(input_data[2])
    B = int(input_data[3])
    
    bad_intervals = []
    idx = 4
    for _ in range(M):
        l = int(input_data[idx])
        r = int(input_data[idx+1])
        bad_intervals.append((l, r))
        idx += 2
    
    # The problem asks if we can reach N from 1.
    # Since A and B are small (<= 20), we can think about the reachability
    # in terms of "reachable range".
    # Let [min_reach, max_reach] be the range of squares we can reach.
    # However, because there are "bad" gaps, the reachable set might be 
    # a collection of intervals.
    
    # But wait, the constraints on A and B are very small.
    # If we are at square x, we can reach any square in [x+A, x+B] 
    # that is not bad.
    # Let's maintain the set of reachable squares. Since N is large, 
    # we can't store all.
    # Notice that if we can reach a square x, we can reach any square y 
