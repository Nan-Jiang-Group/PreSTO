[run_powersampling_mh_vllm] INFO: sample 5 response_length=761 prediction=import sys

def solve():
    # Read N and D from the first line
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    N = int(input_data[0])
    D = int(input_data[1])
    
    snakes = []
    idx = 2
    for _ in range(N):
        t = int(input_data[idx])
        l = int(input_data[idx+1])
        snakes.append((t, l))
        idx += 2
        
    # For each k from 1 to D
    for k in range(1, D + 1):
        max_weight = -1
        for t, l in snakes:
            # Weight = thickness * (initial length + k)
            current_weight = t * (l + k)
            if current_weight > max_weight:
                max_weight = current_weight
        print(max_weight)

if __name__ == "__main__":
    solve() is_correct=True justification=
