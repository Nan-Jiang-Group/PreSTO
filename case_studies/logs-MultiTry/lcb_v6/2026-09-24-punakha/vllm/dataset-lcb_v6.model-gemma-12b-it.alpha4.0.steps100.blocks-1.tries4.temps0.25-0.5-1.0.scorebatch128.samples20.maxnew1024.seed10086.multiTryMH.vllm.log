def solve():
    # Read the input string from standard input
    line = sys.stdin.readline().strip()
    
    if not line:
        return

    # The string is in the format "DxD" where D is a digit and x is 'x'
    # Extract the first digit and the last digit
    first_digit = int(line[0])
    second_digit = int(line[2])
    
    # Calculate the product
    product = first_digit * second_digit
    
    # Print the result
    print(product)

