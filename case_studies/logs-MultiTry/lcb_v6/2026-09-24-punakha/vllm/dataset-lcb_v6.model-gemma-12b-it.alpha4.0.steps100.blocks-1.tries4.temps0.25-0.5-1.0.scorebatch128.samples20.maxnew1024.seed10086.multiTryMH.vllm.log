[run_powersampling_mh_vllm] INFO: sample 10 response_length=3540 prediction=import sys

def solve():
    """
    The problem asks for the maximum number of pairs (a, b) from a sorted list
    such that a <= b/2. This is a classic greedy matching problem.
    
    Since the sequence is sorted, we can use a two-pointer approach.
    We want to pair the smallest available mochi with the smallest possible 
    mochi that is at least twice its size.
    
    Why does this work?
    Suppose we have a small mochi 'a'. To maximize the number of pairs, 
    we should pair it with the smallest 'b' such that b >= 2a. 
    Using a larger 'b' would only restrict our options for other small mochi.
    """
    # Read N
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    n = int(input_data[0])
    # Read the sorted list of mochi sizes
    a = list(map(int, input_data[1:]))
    
    count = 0
    left = 0
    right = 1
    
    # Use two pointers to find pairs
    # 'left' points to the smaller mochi (top)
    # 'right' points to the larger mochi (bottom)
    while left < n and right < n:
        if a[left] * 2 <= a[right]:
            # We found a valid pair
            count += 1
            left += 1
            right += 1
        else:
            # a[right] is too small to be the base for a[left]
            # Since the list is sorted, we need a larger base
            right += 1
            
    print(count)

