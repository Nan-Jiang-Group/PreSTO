def solve():
    # Read X from standard input
    line = sys.stdin.readline()
    if not line:
        return
    try:
        x = int(line.strip())
    except ValueError:
        return

    total_sum = 0
    
    # Iterate through the 9x9 multiplication table
    # i represents the row index (1 to 9)
    # j represents the column index (1 to 9)
    for i in range(1, 10):
        for j in range(1, 10):
            val = i * j
            # If the value in the cell is not X, add it to the total sum
            if val != x:
                total_sum += val
                
    # Print the final sum to standard output
    print(total_sum)

if __name__ == "__main__":
    solve() is_correct=True justification=
