```python
import sys

def solve():
    # Read the input string S
    S = sys.stdin.read().strip()
    
    # Extract the digits
    # The format is guaranteed to be digit 'x' digit
    # S[0] is the first digit
    # S[2] is the second digit
    
    num1 = int(S[0])
    num2 = int(S[2])
    
    # Calculate product
    result = num1 * num2
    
    # Print the result
    print(result)

if __name__ == '__main__':
    solve()
```
