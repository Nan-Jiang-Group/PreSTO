[run_powersampling_mh_sglang] INFO: sample 12 response_length=3998 prediction=import sys

def solve():
    # Read X from standard input
    try:
        input_str = sys.stdin.read().strip()
        if not input_str:
            return
        X = int(input_str)
    except ValueError:
        return

    n = 1
    factorial = 1
    
    # We need to find N such that N! = X.
    # Since X >= 2, N >= 2.
    # We can iterate n starting from 2.
    
    while factorial < X:
        n += 1
        factorial *= n
        
    print(n)

if __name__ == '__main__':
    solve() is_correct=True justification=
