```python
import sys

def main():
    # Read input from stdin
    line = sys.stdin.read().strip()
    if not line:
        return
    parts = line.split()
    if len(parts) >= 2:
        a = int(parts[0])
        b = int(parts[1])
        result = (a + b) ** 2
        print(result)

if __name__ == '__main__':
    main()
```
