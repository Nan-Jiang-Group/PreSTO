```python
import sys

def main():
    # Read the string S from standard input
    # Using sys.stdin.read().split() handles potential whitespace issues around the input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    S = input_data[0]
    
    # The string S is guaranteed to be 3 characters: digit, 'x', digit
    # We convert the first and third characters to integers
    digit1 = int(S[0])
    digit2 = int(S[2])
    
    # Calculate the product
    product = digit1 * digit2
    
    # Print the result
    print(product)

if __name__ == '__main__':
    main()
