Let's write the code.

```python
import sys

def solve():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        n_str = next(iterator)
        d_str = next(iterator)
        N = int(n_str)
        D = int(d_str)
    except StopIteration:
        return

    snakes = []
    for _ in range(N):
        t_str = next(iterator)
        l_str = next(iterator)
        T = int(t_str)
        L = int(l_str)
        snakes.append((T, L))

    # Process for each k from 1 to D
    for k in range(1, D + 1):
        max_weight = 0
        for T, L in snakes:
            current_weight = T * (L + k)
            if current_weight > max_weight:
                max_weight = current_weight
        print(max_weight)

