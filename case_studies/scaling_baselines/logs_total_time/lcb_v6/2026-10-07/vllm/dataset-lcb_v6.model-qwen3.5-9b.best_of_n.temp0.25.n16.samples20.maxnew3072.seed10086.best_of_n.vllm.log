    # Convert tokens to integers
    A = [int(token) for token in tokens]
    
    # The target sorted sequence
    target = [1, 2, 3, 4, 5]
    
    # We need to check if exactly one swap of adjacent elements sorts A.
    # Since the length is fixed at 5, we can iterate through all 4 possible adjacent swaps.
    possible = False
    for i in range(4):
        # Create a copy of the current sequence
        current_A = A.copy()
        
        # Swap the element at index i with the element at index i+1
        current_A[i], current_A[i+1] = current_A[i+1], current_A[i]
        
        # Check if the modified sequence matches the target sorted sequence
        if current_A == target:
            possible = True
            break
    
    if possible:
        print("Yes")
    else:
        print("No")

