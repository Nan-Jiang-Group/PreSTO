def main():
    # Read the integer X from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    X = int(input_data[0])

    # Initialize sum
    ans = 0
    
    # Iterate over the 9x9 multiplication table
    for i in range(1, 10):
        for j in range(1, 10):
            product = i * j
            # Add to sum if the product is not X
            if product != X:
                ans += product
                
    # Print the result
    print(ans)

