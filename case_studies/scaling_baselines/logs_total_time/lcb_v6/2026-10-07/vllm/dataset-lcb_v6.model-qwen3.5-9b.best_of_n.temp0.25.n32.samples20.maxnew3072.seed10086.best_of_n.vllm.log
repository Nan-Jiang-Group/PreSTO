def solve():
    # Read all input from standard input
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        # Read N and D
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        # Read N pairs of (T, L)
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
            
        # For each k from 1 to D
        for k in range(1, D + 1):
            max_weight = 0
            # Iterate over all snakes to find the maximum weight
            for T, L in snakes:
                # New length is L + k
                # Weight is T * (L + k)
                current_weight = T * (L + k)
                if current_weight > max_weight:
                    max_weight = current_weight
            print(max_weight)
            
    except StopIteration:
        pass

