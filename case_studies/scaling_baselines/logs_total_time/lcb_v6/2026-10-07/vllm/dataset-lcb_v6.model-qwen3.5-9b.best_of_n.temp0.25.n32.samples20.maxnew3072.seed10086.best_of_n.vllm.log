def main():
    # Read X from standard input
    try:
        input_data = sys.stdin.read().strip()
        if not input_data:
            return
        X = int(input_data)
    except ValueError:
        return

    # Calculate the sum of all integers in the 9x9 multiplication table
    # that are not equal to X.
    total_sum = 0
    for i in range(1, 10):
        for j in range(1, 10):
            val = i * j
            if val != X:
                total_sum += val
    
    print(total_sum)

