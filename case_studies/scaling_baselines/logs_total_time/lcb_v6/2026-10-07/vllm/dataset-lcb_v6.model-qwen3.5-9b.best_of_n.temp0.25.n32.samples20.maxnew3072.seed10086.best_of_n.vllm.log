def main():
    # Read all tokens from standard input
    input_data = sys.stdin.read().split()
    
    # Ensure there is input to process
    if not input_data:
        return

    # Convert tokens to integers
    A = [int(x) for x in input_data]
    
    # The target sorted sequence is always 1, 2, 3, 4, 5
    target = [1, 2, 3, 4, 5]
    
    # We need to determine if exactly one adjacent swap sorts A.
    # Since the length is fixed at 5, we can just brute-force all adjacent swaps.
    can_be_sorted = False
    
    # Iterate through indices 0 to 3 (since we swap i and i+1)
    for i in range(len(A) - 1):
        # Create a copy of the current sequence
        current = A[:]
        
        # Perform the swap
        current[i], current[i+1] = current[i+1], current[i]
        
        # Check if the sequence is now sorted
        if current == target:
            can_be_sorted = True
            break
    
    # Output the result
    if can_be_sorted:
        print("Yes")
    else:
        print("No")

