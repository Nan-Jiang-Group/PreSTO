def main():
    # Read X from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    X = int(input_data[0])

    # Calculate the sum of all numbers in the 9x9 grid excluding X
    total_sum = 0
    for i in range(1, 10):
        for j in range(1, 10):
            val = i * j
            if val != X:
                total_sum += val

    print(total_sum)

if __name__ == '__main__':
