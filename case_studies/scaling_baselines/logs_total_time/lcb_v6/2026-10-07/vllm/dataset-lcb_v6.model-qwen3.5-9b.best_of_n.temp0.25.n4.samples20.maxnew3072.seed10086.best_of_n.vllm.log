[run_best_of_n_vllm] INFO: sample 19 [N=4] response_length=9404 prediction=import sys

def solve():
    # Read all tokens from standard input
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    # Convert tokens to integers
    A = [int(x) for x in input_data]
    
    # The target sorted sequence
    target = [1, 2, 3, 4, 5]
    
    # We need to determine if A can be sorted by exactly one adjacent swap.
    # Since the length of A is 5, there are only 4 possible adjacent swaps.
    # We can simulate each swap and check if the result matches the target.
    
    can_be_sorted = False
    
    # Iterate through indices 0 to 3 to swap A[i] and A[i+1]
    for i in range(4):
        # Create a copy of A to avoid modifying the original list
        temp_A = A.copy()
        
        # Perform the swap
        temp_A[i], temp_A[i+1] = temp_A[i+1], temp_A[i]
        
        # Check if the result is the sorted sequence
        if temp_A == target:
            can_be_sorted = True
            break
            
    if can_be_sorted:
        print("Yes")
    else:
        print("No")

if __name__ == '__main__':
    solve() is_correct=True justification=
