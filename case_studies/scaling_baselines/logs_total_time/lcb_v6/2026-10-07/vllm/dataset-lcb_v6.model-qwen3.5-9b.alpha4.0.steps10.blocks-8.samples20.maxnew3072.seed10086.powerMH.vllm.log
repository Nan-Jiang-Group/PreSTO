def solve():
    try:
        line = sys.stdin.read().strip()
        if not line:
            return
        X = int(line)
    except ValueError:
        return

    n = 1
    fact = 1
    while fact < X:
        n += 1
        fact *= n
    
    print(n)

if __name__ == '__main__':
    solve() is_correct=True justification=
