def main():
    # Read all input from standard input
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    # Parse X
    X = int(input_data[0])

    # Calculate the sum of numbers in the 9x9 multiplication table that are not equal to X
    total_sum = 0
    for i in range(1, 10):
        for j in range(1, 10):
            val = i * j
            if val != X:
                total_sum += val

    # Output the result
    print(total_sum)

if __name__ == '__main__':
    main() is_correct=True justification=
