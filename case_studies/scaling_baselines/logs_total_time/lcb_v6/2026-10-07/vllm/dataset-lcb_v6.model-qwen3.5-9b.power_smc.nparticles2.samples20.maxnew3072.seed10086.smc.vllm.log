[run_power_smc_vllm] INFO: sample 19 response_length=9354 prediction=import sys

def solve():
    # Read all input from standard input
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    # Parse the integers into a list
    A = [int(x) for x in input_data]
    
    # The target sorted sequence
    target = [1, 2, 3, 4, 5]
    
    # We need to check if swapping exactly one pair of adjacent elements
    # results in the target sequence.
    # Since the length is small (5), we can iterate through all adjacent pairs.
    
    can_be_sorted = False
    
    # Iterate through indices 0 to 3 (since we swap i and i+1)
    for i in range(len(A) - 1):
        # Create a copy of the current sequence
        temp_A = A.copy()
        
        # Swap the adjacent elements at index i and i+1
        temp_A[i], temp_A[i+1] = temp_A[i+1], temp_A[i]
        
        # Check if the modified sequence matches the target
        if temp_A == target:
            can_be_sorted = True
            break
            
    if can_be_sorted:
        print("Yes")
    else:
        print("No")

if __name__ == '__main__':
    solve() is_correct=True justification=
