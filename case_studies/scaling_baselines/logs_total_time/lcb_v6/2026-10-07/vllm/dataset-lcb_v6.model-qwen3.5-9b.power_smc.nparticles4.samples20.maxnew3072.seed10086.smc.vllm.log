[run_power_smc_vllm] INFO: sample 19 response_length=9419 prediction=import sys

def solve():
    # Read the input sequence A
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    A = [int(x) for x in input_data]
    
    # The target sorted sequence
    target = [1, 2, 3, 4, 5]
    
    # We need to check if exactly one adjacent swap sorts A.
    # Since the length is small (5), we can try all possible adjacent swaps.
    possible = False
    
    # Iterate through all adjacent pairs (i, i+1)
    for i in range(len(A) - 1):
        # Create a copy of A to simulate the swap
        B = A[:]
        
        # Swap elements at indices i and i+1
        B[i], B[i+1] = B[i+1], B[i]
        
        # Check if the resulting sequence is sorted
        if B == target:
            possible = True
            break
            
    if possible:
        print("Yes")
    else:
        print("No")

if __name__ == '__main__':
    solve() is_correct=True justification=
