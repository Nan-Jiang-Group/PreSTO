[run_power_smc_vllm] INFO: sample 5 response_length=9778 prediction=import sys

def main():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        # Read N and D
        N = int(next(iterator))
        D = int(next(iterator))
        
        # Read the snakes' data
        snakes = []
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
        
        # Iterate for each k from 1 to D
        for k in range(1, D + 1):
            max_weight = 0
            # Calculate weight for each snake with increased length (L + k)
            for T, L in snakes:
                weight = T * (L + k)
                if weight > max_weight:
                    max_weight = weight
            print(max_weight)
            
    except StopIteration:
        pass

if __name__ == '__main__':
    main() is_correct=True justification=
