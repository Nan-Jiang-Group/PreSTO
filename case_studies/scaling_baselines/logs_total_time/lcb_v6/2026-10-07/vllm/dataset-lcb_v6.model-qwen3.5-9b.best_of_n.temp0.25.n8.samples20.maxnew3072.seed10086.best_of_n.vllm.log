def solve():
    # Read the input sequence A
    # The input is given as space-separated integers on a single line (or potentially multiple lines, though usually one)
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    # Convert strings to integers
    A = [int(x) for x in input_data]
    
    # The target sorted sequence
    target = [1, 2, 3, 4, 5]
    
    # We need to check if swapping exactly one pair of adjacent elements sorts A.
    # Since the length is fixed at 5, we can iterate through all possible adjacent swaps.
    # Indices for adjacent pairs are (0,1), (1,2), (2,3), (3,4).
    
    can_be_sorted = False
    
    for i in range(4):
        # Create a copy of A to simulate the swap
        temp_A = A[:]
        
        # Swap elements at index i and i+1
        temp_A[i], temp_A[i+1] = temp_A[i+1], temp_A[i]
        
        # Check if the resulting sequence is sorted
        if temp_A == target:
            can_be_sorted = True
            break
            
    if can_be_sorted:
        print("Yes")
