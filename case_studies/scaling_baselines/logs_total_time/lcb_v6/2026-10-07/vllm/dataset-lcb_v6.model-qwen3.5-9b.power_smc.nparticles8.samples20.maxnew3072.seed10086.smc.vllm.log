# Read input from stdin
input_data = sys.stdin.read().split()

if input_data:
    A = [int(x) for x in input_data]
    target = [1, 2, 3, 4, 5]
    
    # Check if any single adjacent swap results in the target sequence
    can_sort = False
    for i in range(len(A) - 1):
        # Create a copy to simulate the swap
        temp_A = A[:]
        # Swap adjacent elements
        temp_A[i], temp_A[i+1] = temp_A[i+1], temp_A[i]
        
        # Check against target
        if temp_A == target:
            can_sort = True
            break
            
    if can_sort:
        print("Yes")
    else:
        print("No") is_correct=True justification=
