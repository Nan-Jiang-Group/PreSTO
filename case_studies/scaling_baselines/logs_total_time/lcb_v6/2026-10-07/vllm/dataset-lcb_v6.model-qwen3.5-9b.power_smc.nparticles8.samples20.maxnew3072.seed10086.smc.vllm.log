def main():
    # Read the input integer X
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    X = int(input_data[0])

    # Initialize the sum
    total_sum = 0

    # Iterate through the 9x9 multiplication table
    # Rows i from 1 to 9, Columns j from 1 to 9
    for i in range(1, 10):
        for j in range(1, 10):
            val = i * j
            # Add to sum if the value is not X
            if val != X:
                total_sum += val

    # Print the result
    print(total_sum)

if __name__ == '__main__':
    main() is_correct=True justification=
