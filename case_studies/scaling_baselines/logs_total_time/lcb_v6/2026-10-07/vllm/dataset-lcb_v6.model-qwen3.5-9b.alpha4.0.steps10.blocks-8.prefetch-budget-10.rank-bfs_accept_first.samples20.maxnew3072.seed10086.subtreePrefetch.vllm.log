import sys

def solve():
    # Read input from stdin
    try:
        input_data = sys.stdin.read().split()
        if not input_data:
            return
        A = [int(x) for x in input_data]
    except ValueError:
        return

    target = [1, 2, 3, 4, 5]
    
    # Try swapping every adjacent pair
    possible = False
    for i in range(len(A) - 1):
        # Create a copy to simulate the swap
        B = A[:]
        # Swap elements at i and i+1
        B[i], B[i+1] = B[i+1], B[i]
        
        # Check if sorted
        if B == target:
            possible = True
            break
            
    if possible:
        print("Yes")
    else:
        print("No")

if __name__ == '__main__':
    solve()
