            L = int(next(iterator))
            snakes.append((T, L))
            
        # For each k from 1 to D, calculate the max weight
        for k in range(1, D + 1):
            current_max_weight = 0
            for T, L in snakes:
                # The new length is L + k
                # The weight is T * (L + k)
                weight = T * (L + k)
                if weight > current_max_weight:
