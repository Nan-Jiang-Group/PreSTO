import sys

# Read the input string S from standard input
S = sys.stdin.readline().strip()

# The string S is guaranteed to be of the format "dx" where d is a digit and x is 'x'.
# Actually, it is "d1 x d2".
# We need to parse the first and third characters as integers.

# Extract the first digit
first_digit = int(S[0])

# Extract the second digit (third character of string)
second_digit = int(S[2])

# Calculate the product
product = first_digit * second_digit

# Print the result
print(product)
```
