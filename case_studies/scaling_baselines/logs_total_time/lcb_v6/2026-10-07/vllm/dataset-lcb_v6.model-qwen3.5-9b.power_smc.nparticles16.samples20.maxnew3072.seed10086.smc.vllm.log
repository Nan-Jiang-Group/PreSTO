        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        # Parse each snake's T and L
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
        
        # For each k from 1 to D, find the max weight
        for k in range(1, D + 1):
            current_max = 0
            for T, L in snakes:
                weight = T * (L + k)
                if weight > current_max:
                    current_max = weight
            print(current_max)
            
    except StopIteration:
        pass

