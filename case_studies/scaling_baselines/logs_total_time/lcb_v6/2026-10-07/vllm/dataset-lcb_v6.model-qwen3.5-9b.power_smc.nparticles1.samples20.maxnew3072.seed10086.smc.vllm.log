def main():
    # Read the input X from Standard Input
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return
        
    X = int(input_data[0])
    
    # Initialize the sum variable
    total_sum = 0
    
    # Iterate through the 9x9 multiplication table
    # Rows i from 1 to 9
    for i in range(1, 10):
        # Columns j from 1 to 9
        for j in range(1, 10):
            # Calculate the integer in the cell
            val = i * j
            
            # If the integer is not X, add it to the sum
            if val != X:
                total_sum += val
                
    # Print the calculated sum
    print(total_sum)

if __name__ == '__main__':
    main() is_correct=True justification=
