[run_power_smc_vllm] INFO: sample 5 response_length=9933 prediction=import sys

def main():
    # Read all content from standard input
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    # Create an iterator to consume the input tokens
    iterator = iter(input_data)
    
    try:
        # First two tokens are N and D
        N = int(next(iterator))
        D = int(next(iterator))
        
        # List to store (Thickness, Length) for each snake
        snakes = []
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
        
        # For each k from 1 to D, find the maximum weight
        for k in range(1, D + 1):
            max_weight = 0
            for T, L in snakes:
                # New length is L + k
                # Weight is Thickness * New Length
                weight = T * (L + k)
                if weight > max_weight:
                    max_weight = weight
            print(max_weight)
            
    except StopIteration:
        pass

if __name__ == '__main__':
    main() is_correct=True justification=
