[run_power_smc_vllm] INFO: sample 19 response_length=9397 prediction=import sys

def main():
    # Read all tokens from standard input
    input_data = sys.stdin.read().split()
    
    # If no input is provided, just return (though constraints imply valid input)
    if not input_data:
        return

    # Convert tokens to integers
    A = [int(x) for x in input_data]
    
    # The target sorted sequence
    target = [1, 2, 3, 4, 5]
    
    # Flag to track if a valid swap exists
    can_be_sorted = False
    
    # Try swapping every adjacent pair (indices 0-1, 1-2, 2-3, 3-4)
    for i in range(len(A) - 1):
        # Create a copy of the current sequence
        temp_A = A[:]
        
        # Perform the swap
        temp_A[i], temp_A[i+1] = temp_A[i+1], temp_A[i]
        
        # Check if the sequence is now sorted
        if temp_A == target:
            can_be_sorted = True
            break
            
    if can_be_sorted:
        print("Yes")
    else:
        print("No")

if __name__ == '__main__':
    main() is_correct=True justification=
