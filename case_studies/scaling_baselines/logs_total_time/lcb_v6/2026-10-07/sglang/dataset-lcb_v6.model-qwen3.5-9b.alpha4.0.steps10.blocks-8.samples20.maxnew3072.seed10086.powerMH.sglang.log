[run_powersampling_mh_sglang] INFO: sample 5 response_length=9645 prediction=import sys

def main():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        # Read N and D
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        # Read T_i and L_i for each snake
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
            
        # Process each k from 1 to D
        for k in range(1, D + 1):
            max_weight = 0
            for T, L in snakes:
                # Calculate weight with increased length
                weight = T * (L + k)
                if weight > max_weight:
                    max_weight = weight
            print(max_weight)
            
    except StopIteration:
        pass

if __name__ == '__main__':
    main() is_correct=True justification=
