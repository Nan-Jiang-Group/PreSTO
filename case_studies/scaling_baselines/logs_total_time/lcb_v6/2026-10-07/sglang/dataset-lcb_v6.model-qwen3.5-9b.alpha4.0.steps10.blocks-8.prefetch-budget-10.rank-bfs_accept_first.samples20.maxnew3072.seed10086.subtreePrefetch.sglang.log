    try:
        n_str = next(iterator)
        d_str = next(iterator)
        N = int(n_str)
        D = int(d_str)
    except StopIteration:
        return

    # Read the N snakes' properties
    snakes = []
    for _ in range(N):
        try:
            t_str = next(iterator)
            l_str = next(iterator)
            T = int(t_str)
            L = int(l_str)
            snakes.append((T, L))
        except StopIteration:
            break

    # For each k from 1 to D, find the maximum weight
    for k in range(1, D + 1):
        max_weight = 0
        for T, L in snakes:
            # Weight = Thickness * (Length + k)
            current_weight = T * (L + k)
            if current_weight > max_weight:
                max_weight = current_weight
        print(max_weight)

if __name__ == '__main__':
    main()
