import sys

# Read A and B from stdin
# sys.stdin.read() reads the whole input buffer
# .split() splits by any whitespace (spaces, newlines)
tokens = sys.stdin.read().split()

A = int(tokens[0])
B = int(tokens[1])

# Compute (A + B)^2
result = (A + B) ** 2

# Print the result
print(result)
```
