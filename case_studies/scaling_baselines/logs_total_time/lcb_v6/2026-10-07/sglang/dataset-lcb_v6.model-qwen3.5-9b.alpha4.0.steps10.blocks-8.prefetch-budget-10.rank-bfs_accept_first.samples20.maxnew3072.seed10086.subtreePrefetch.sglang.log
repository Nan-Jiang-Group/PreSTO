import sys

def main():
    # Read all input from standard input
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    # Parse A and B
    A = int(input_data[0])
    B = int(input_data[1])
    
    # Calculate (A + B)^2
    result = (A + B) ** 2
    
    # Print the result
    print(result)

if __name__ == '__main__':
    main()
```
