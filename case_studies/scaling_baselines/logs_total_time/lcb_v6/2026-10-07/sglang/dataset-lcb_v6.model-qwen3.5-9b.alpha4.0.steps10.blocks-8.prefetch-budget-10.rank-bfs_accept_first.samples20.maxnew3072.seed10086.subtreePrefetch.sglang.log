```python
import sys

def main():
    # Read input from stdin
    line = sys.stdin.read().strip()
    if not line:
        return
    parts = line.split()
    A = int(parts[0])
    B = int(parts[1])
    
    # Calculate result
    result = (A + B) ** 2
    
    # Print result to stdout
    print(result)

if __name__ == '__main__':
    main()
```
