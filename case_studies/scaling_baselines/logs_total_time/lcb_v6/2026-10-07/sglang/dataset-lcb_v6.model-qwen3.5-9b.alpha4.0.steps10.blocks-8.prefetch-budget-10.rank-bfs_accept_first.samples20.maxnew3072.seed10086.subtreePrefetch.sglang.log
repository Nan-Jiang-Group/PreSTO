import sys

def main():
    # Read all input from stdin
    input_str = sys.stdin.read().strip()
    if not input_str:
        return
    
    X = int(input_str)
    
    n = 1
    fact = 1
    
    # Since X >= 2, we start checking.
    # We can increment n and update fact until fact >= X.
    # Since a solution is guaranteed, we will eventually hit fact == X.
    
    while fact < X:
        n += 1
        fact *= n
        
    print(n)

if __name__ == '__main__':
    main()
