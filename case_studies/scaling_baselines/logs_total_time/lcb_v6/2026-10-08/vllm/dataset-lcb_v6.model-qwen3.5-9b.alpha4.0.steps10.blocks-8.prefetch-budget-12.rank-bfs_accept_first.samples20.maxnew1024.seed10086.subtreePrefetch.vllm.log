```python
import sys

def solve():
    # Read the string S
    # Using sys.stdin.read().split() handles potential whitespace issues better
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    S = input_data[0]
    
    # Parse the digits
    # S format is "dxd"
    num1 = int(S[0])
    num2 = int(S[2])
    
    # Compute product
    ans = num1 * num2
    
    # Print output
