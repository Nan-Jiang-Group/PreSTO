def solve():
    try:
        input_data = sys.stdin.read().split()
        if not input_data:
            return
        X = int(input_data[0])
    except ValueError:
        return

    n = 1
    fact = 1
    while True:
        if fact == X:
            print(n)
            return
        if fact > X:
            # This case shouldn't be reached given the problem statement guarantees a solution
            break
        n += 1
        fact *= n

if __name__ == '__main__':
    solve() is_correct=True justification=
