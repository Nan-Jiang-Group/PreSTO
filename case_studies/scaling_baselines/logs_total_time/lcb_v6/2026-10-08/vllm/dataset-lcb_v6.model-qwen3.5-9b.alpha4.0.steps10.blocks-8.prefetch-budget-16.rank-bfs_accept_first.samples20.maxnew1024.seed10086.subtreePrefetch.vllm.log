```python
import sys

def solve():
    s = sys.stdin.read().strip()
    # s is expected to be like "3x8"
    # s[0] is the first digit
    # s[2] is the second digit
    
    # Alternatively, split by 'x'
    parts = s.split('x')
    a = int(parts[0])
    b = int(parts[1])
    print(a * b)

if __name__ == '__main__':
    solve()
```
