**Implementation Details:**
- Use `sys.stdin.read` or `input()` to get data.
- Parse integers.
- Nested loops.
- Print results.

```python
import sys

def solve():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
            
        for k in range(1, D + 1):
            max_weight = 0
            for T, L in snakes:
                weight = T * (L + k)
                if weight > max_weight:
                    max_weight = weight
            print(max_weight)
            
    except StopIteration:
        pass is_correct=False justification=Code is incorrect.
