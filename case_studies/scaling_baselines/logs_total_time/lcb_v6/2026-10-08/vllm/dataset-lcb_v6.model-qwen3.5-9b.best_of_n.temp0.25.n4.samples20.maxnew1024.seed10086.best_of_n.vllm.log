[run_best_of_n_vllm] INFO: sample 19 [N=4] response_length=2911 prediction=import sys

def solve():
    # Read input
    try:
        line = sys.stdin.read().split()
        if not line:
            return
        A = [int(x) for x in line]
    except ValueError:
        return

    target = [1, 2, 3, 4, 5]
    
    # Try swapping every adjacent pair
    # Indices 0 to 3 for a list of length 5
    possible = False
    for i in range(len(A) - 1):
        # Create a copy to swap
        B = A[:]
        # Swap elements at i and i+1
        B[i], B[i+1] = B[i+1], B[i]
        
        # Check if sorted
        if B == target:
            possible = True
            break
            
    if possible:
        print("Yes")
    else:
        print("No")

if __name__ == '__main__':
    solve() is_correct=True justification=
