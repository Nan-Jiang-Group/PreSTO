    try:
        line = sys.stdin.read().strip()
        if not line:
            return
        X = int(line)
    except ValueError:
        return

    n = 1
    fact = 1
    
    # Since X >= 2, N >= 2.
    # We can start checking from n=1, fact=1.
    # If X=1, N=1, but constraint says X>=2.
    
    while fact < X:
        n += 1
        fact *= n
        
    print(n)

