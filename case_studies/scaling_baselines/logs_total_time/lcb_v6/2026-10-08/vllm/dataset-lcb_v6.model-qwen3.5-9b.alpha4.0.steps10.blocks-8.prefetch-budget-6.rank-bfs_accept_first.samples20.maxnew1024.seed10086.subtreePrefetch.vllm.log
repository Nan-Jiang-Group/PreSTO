```python
import sys

def solve():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        n_str = next(iterator)
        d_str = next(iterator)
        N = int(n_str)
        D = int(d_str)
        
        snakes = []
        for _ in range(N):
            t = int(next(iterator))
            l = int(next(iterator))
            snakes.append((t, l))
            
        # Process for each k from 1 to D
        for k in range(1, D + 1):
            max_weight = 0
            for t, l in snakes:
                weight = t * (l + k)
                if weight > max_weight:
                    max_weight = weight
            print(max_weight)
            
    except StopIteration:
        pass

if __name__ == '__main__':
    solve()
```

