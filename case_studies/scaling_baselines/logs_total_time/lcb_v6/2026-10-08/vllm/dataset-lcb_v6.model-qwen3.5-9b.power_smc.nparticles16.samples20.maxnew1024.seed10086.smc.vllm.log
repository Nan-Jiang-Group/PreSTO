[run_power_smc_vllm] INFO: sample 19 response_length=2898 prediction=import sys

def solve():
    # Read input
    try:
        line = sys.stdin.read().split()
        if not line:
            return
        A = [int(x) for x in line]
    except ValueError:
        return

    target = [1, 2, 3, 4, 5]
    
    # Try swapping adjacent elements
    possible = False
    for i in range(len(A) - 1):
        # Create a copy to simulate swap
        B = A[:]
        # Swap A[i] and A[i+1]
        B[i], B[i+1] = B[i+1], B[i]
        
        # Check if sorted
        if B == target:
            possible = True
            break
            
    if possible:
        print("Yes")
    else:
        print("No")

if __name__ == '__main__':
    solve() is_correct=True justification=
