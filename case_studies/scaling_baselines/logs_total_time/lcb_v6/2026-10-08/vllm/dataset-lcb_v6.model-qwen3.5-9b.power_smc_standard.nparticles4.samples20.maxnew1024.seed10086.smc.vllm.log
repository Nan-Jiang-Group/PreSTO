import sys

def solve():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        for _ in range(N):
            t = int(next(iterator))
            l = int(next(iterator))
            snakes.append((t, l))
            
        for k in range(1, D + 1):
            max_weight = 0
            for t, l in snakes:
                weight = t * (l + k)
                if weight > max_weight:
                    max_weight = weight
            print(max_weight)
            
    except StopIteration:
        pass

