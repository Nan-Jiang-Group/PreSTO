def solve():
    # Read X from stdin
    try:
        input_data = sys.stdin.read().split()
        if not input_data:
            return
        X = int(input_data[0])
    except ValueError:
        return

    # Since N is small (<= 20), we can just iterate.
    # Start with n=1, fact=1
    n = 1
    fact = 1
    
    # We need to find n such that n! = X
    # Since X >= 2, n will be at least 2.
    # We can loop until fact >= X.
    
    while fact < X:
        n += 1
        fact *= n
        
    # Since it is guaranteed that a solution exists, fact should equal X here.
    print(n)

if __name__ == '__main__':
    solve() is_correct=True justification=
