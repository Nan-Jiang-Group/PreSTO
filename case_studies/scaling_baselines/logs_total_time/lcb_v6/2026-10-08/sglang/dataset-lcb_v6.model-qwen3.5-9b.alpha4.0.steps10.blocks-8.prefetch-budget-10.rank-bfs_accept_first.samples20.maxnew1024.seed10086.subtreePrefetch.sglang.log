```python
import sys

def solve():
    # Read S from standard input
    S = sys.stdin.read().strip()
    
    # Check if input is empty just in case, though constraints say length >= 1
    if not S:
        return

    # Get the first character
    first_char = S[0]
    
    # Concatenate with "UPC"
    result = first_char + "UPC"
    
    # Print the result
    print(result)

if __name__ == '__main__':
    solve()
```
