[run_power_smc_vllm] INFO: sample 5 response_length=10145 prediction=import sys

def main():
    # Read all input from standard input
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        # Parse N and D
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        # Parse the snakes' data
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
            
        # Process each k from 1 to D
        for k in range(1, D + 1):
            # Calculate max weight for current k
            # Weight of snake i is T_i * (L_i + k)
            max_w = 0
            for T, L in snakes:
                w = T * (L + k)
                if w > max_w:
                    max_w = w
            print(max_w)
            
    except StopIteration:
        pass

if __name__ == '__main__':
    main() is_correct=True justification=
