    # Try swapping each adjacent pair
    possible = False
    for i in range(4):
        # Make a copy to swap
        temp = A[:]
        temp[i], temp[i+1] = temp[i+1], temp[i]
        
        if temp == target:
            possible = True
            break
            
    if possible:
        print("Yes")
    else:
        print("No") is_correct=True justification=
