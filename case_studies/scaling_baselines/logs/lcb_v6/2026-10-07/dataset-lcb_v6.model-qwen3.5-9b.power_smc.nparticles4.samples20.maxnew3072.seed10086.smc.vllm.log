[run_power_smc_vllm] INFO: sample 12 response_length=9637 prediction=import sys

# Increase recursion depth just in case, though not needed here
sys.setrecursionlimit(2000)

def main():
    # Read input from stdin
    # Using sys.stdin.read().split() handles whitespace and newlines robustly
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return
        
    X = int(input_data[0])
    
    # Since X <= 3 * 10^18, N will be at most 20.
    # We can iterate to find N.
    
    n = 1
    fact = 1
    
    while fact < X:
        n += 1
        fact *= n
        
    print(n)

if __name__ == '__main__':
    main() is_correct=True justification=
