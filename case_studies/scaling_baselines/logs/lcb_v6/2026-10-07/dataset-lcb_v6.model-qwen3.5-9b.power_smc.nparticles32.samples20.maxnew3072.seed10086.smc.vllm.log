def main():
    # Read the entire input from stdin
    input_data = sys.stdin.read().split()
    
    # If there's no input, just return (though constraints guarantee input)
    if not input_data:
        return

    # Parse the integers
    A = [int(x) for x in input_data]
    
    # The target sorted sequence
    target = [1, 2, 3, 4, 5]
    
    # We need to check if exactly one adjacent swap sorts the array.
    # Since the array length is fixed at 5, we can brute-force all 4 possible adjacent swaps.
    
    can_sort = False
    for i in range(4):
        # Create a copy of A to simulate the swap
        temp = A[:]
        
        # Swap elements at index i and i+1
        temp[i], temp[i+1] = temp[i+1], temp[i]
        
        # Check if the resulting array matches the target
        if temp == target:
            can_sort = True
            break
    
    if can_sort:
        print("Yes")
    else:
        print("No")

