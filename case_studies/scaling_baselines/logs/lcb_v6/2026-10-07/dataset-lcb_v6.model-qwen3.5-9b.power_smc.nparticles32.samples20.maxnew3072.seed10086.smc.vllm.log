# Set up fast I/O
input = sys.stdin.read

def main():
    data = input().split()
    if not data:
        return
    
    iterator = iter(data)
    
    try:
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        for _ in range(N):
            t = int(next(iterator))
            l = int(next(iterator))
            snakes.append((t, l))
            
        for k in range(1, D + 1):
            max_w = 0
            for t, l in snakes:
                w = t * (l + k)
                if w > max_w:
                    max_w = w
            print(max_w)
            
    except StopIteration:
        pass

if __name__ == '__main__':
    main() is_correct=True justification=
