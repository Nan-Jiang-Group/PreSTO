def main():
    # Read the integer X from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    X = int(input_data[0])

    # Initialize the sum variable
    total_sum = 0

    # Iterate through the 9x9 multiplication table
    # The cell at row i and column j contains i * j
    for i in range(1, 10):
        for j in range(1, 10):
            val = i * j
            # Add to sum if the value is not X
            if val != X:
                total_sum += val

    # Print the final result
    print(total_sum)

