    iterator = iter(input_data)
    
    try:
        # Read N (number of snakes) and D (number of queries)
        n_str = next(iterator)
        d_str = next(iterator)
        N = int(n_str)
        D = int(d_str)
        
        # Read the initial thickness and length for each snake
        snakes = []
        for _ in range(N):
            t = int(next(iterator))
            l = int(next(iterator))
            snakes.append((t, l))
            
    except StopIteration:
        return

    # For each integer k from 1 to D
    for k in range(1, D + 1):
        max_weight = 0
        # Calculate the weight for each snake with length increased by k
        # Weight = Thickness * (Initial Length + k)
        for t, l in snakes:
            current_weight = t * (l + k)
            if current_weight > max_weight:
                max_weight = current_weight
        # Print the maximum weight found for this k
        print(max_weight)

