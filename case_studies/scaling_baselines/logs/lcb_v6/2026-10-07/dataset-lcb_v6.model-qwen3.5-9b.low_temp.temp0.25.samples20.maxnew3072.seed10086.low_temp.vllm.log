[run_low_temp_vllm] INFO: sample 0 response_length=9306 prediction=import sys

def main():
    # Read X from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    X = int(input_data[0])

    # Calculate the sum of all integers in the 9x9 multiplication table
    # and count how many times X appears.
    total_sum = 0
    count_X = 0

    for i in range(1, 10):
        for j in range(1, 10):
            val = i * j
            total_sum += val
            if val == X:
                count_X += 1

    # The sum of integers that are not X is total_sum - (count_X * X)
    print(total_sum - count_X * X)

if __name__ == '__main__':
    main() is_correct=True justification=
