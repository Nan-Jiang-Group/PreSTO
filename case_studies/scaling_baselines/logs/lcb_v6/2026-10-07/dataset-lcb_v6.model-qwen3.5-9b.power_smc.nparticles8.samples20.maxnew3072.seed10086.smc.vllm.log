[run_power_smc_vllm] INFO: sample 5 response_length=10128 prediction=import sys

def main():
    # Read all tokens from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        # Parse N and D
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        # Parse each snake's T and L
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
        
        # For each k from 1 to D, find the max weight
        for k in range(1, D + 1):
            current_max = 0
            for T, L in snakes:
                weight = T * (L + k)
                if weight > current_max:
                    current_max = weight
            print(current_max)
            
    except StopIteration:
        pass

if __name__ == '__main__':
    main() is_correct=True justification=
