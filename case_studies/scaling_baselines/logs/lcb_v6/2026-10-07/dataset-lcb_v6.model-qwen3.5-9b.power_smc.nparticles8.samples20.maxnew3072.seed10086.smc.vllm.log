[run_power_smc_vllm] INFO: sample 19 response_length=9704 prediction=import sys

def main():
    # Read all input from standard input
    input_data = sys.stdin.read().split()
    
    # Check if input is empty (though constraints say it won't be)
    if not input_data:
        return

    # Parse the integers
    A = [int(x) for x in input_data]
    
    # The target sorted sequence
    target = [1, 2, 3, 4, 5]
    
    # Flag to track if sorting is possible with exactly one swap
    can_sort = False
    
    # Try swapping every adjacent pair (indices 0-1, 1-2, 2-3, 3-4)
    for i in range(4):
        # Create a copy of A
        temp = A.copy()
        
        # Swap elements at i and i+1
        temp[i], temp[i+1] = temp[i+1], temp[i]
        
        # Check if the result matches the target
        if temp == target:
            can_sort = True
            break
            
    if can_sort:
        print("Yes")
    else:
        print("No")

if __name__ == '__main__':
    main() is_correct=True justification=
