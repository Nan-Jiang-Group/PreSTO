# Increase recursion depth just in case, though not needed here
sys.setrecursionlimit(2000)

def main():
    # Read X from standard input
    try:
        input_data = sys.stdin.read().split()
        if not input_data:
            return
        X = int(input_data[0])
    except ValueError:
        return

    # N! = X
    # Since X >= 2, N >= 2.
    # We can iterate N starting from 1.
    
    n = 1
    fact = 1
    
    # We loop until fact >= X.
    # Since a solution is guaranteed, fact will eventually equal X.
    while fact < X:
        n += 1
        fact *= n
        
    print(n)

if __name__ == '__main__':
    main() is_correct=True justification=
