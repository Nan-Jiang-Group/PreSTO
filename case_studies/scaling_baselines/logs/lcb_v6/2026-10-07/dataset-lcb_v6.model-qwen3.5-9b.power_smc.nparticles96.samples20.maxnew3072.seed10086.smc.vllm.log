def main():
    # Read the integer X from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    X = int(input_data[0])

    # Initialize the sum
    total_sum = 0

    # Iterate through rows i from 1 to 9
    for i in range(1, 10):
        # Iterate through columns j from 1 to 9
        for j in range(1, 10):
            # Calculate the value in the cell
            val = i * j
            # If the value is not X, add it to the sum
            if val != X:
                total_sum += val

    # Print the final sum
    print(total_sum)

