    # Calculate the sum of all 81 integers in the 9x9 multiplication table
    # The sum of integers from 1 to 9 is 45.
    # The total sum is 45 * 45 = 2025.
    total_sum = 2025
    
    # Count how many times X appears in the multiplication table
    # We iterate through rows i=1..9 and columns j=1..9
