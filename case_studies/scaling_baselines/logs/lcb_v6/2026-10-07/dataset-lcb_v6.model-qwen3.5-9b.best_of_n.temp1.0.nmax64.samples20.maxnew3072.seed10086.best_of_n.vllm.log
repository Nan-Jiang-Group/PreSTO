def solve():
    # Reading input using sys.stdin.read().split() handles whitespace (spaces, newlines) automatically
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    # Parse N and D
    try:
        N = int(next(iterator))
        D = int(next(iterator))
    except StopIteration:
        return

    # Parse the snakes' properties
    snakes = []
    for _ in range(N):
        try:
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
        except StopIteration:
            break
            
    # Process each k from 1 to D
    for k in range(1, D + 1):
        max_weight = 0
        for T, L in snakes:
            # Calculate weight: thickness * (length + k)
            current_weight = T * (L + k)
            if current_weight > max_weight:
                max_weight = current_weight
        print(max_weight)

if __name__ == '__main__':
    solve() is_correct=True justification=
