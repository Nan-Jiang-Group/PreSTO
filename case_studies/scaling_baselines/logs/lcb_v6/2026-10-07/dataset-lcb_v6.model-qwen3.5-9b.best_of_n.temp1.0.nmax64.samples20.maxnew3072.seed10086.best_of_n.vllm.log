    # Parse the 5 integers
    A = [int(x) for x in input_data]
    
    # The target sorted sequence
    target = [1, 2, 3, 4, 5]
    
    found = False
    
    # Try swapping every adjacent pair
    # Indices 0 to 3 (pair 0-1, 1-2, 2-3, 3-4)
    for i in range(4):
        # Create a copy of A to perform the swap
        current_A = A.copy()
        # Perform the swap
        current_A[i], current_A[i+1] = current_A[i+1], current_A[i]
        # Check if it matches the target
        if current_A == target:
            found = True
            break
            
    if found:
