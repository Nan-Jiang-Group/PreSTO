import sys

def main():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    # Parse integers A and B
    A = int(input_data[0])
    B = int(input_data[1])
    
    # Compute the square of (A + B)
    result = (A + B) ** 2
    
    # Print the result to stdout
    print(result)

if __name__ == '__main__':
    main() is_correct=True justification=
