import sys

def main():
    # Read all tokens from standard input
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    # Use an iterator to traverse the input tokens
    iterator = iter(input_data)
    
    try:
        # Read N and D
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        # Read each snake's thickness (T) and length (L)
        for _ in range(N):
            t = int(next(iterator))
            l = int(next(iterator))
            snakes.append((t, l))
        
        # Process each k from 1 to D
        for k in range(1, D + 1):
            max_weight = -1
            # Check every snake to find the heaviest
            for t, l in snakes:
                weight = t * (l + k)
                if weight > max_weight:
                    max_weight = weight
            print(max_weight)
            
    except StopIteration:
        # This block handles cases where input might be incomplete, though constraints say otherwise
        pass

if __name__ == '__main__':
    main() is_correct=True justification=
