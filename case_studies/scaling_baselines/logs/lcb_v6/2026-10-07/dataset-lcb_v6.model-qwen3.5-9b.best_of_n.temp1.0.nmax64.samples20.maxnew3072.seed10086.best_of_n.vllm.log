# Increase recursion depth just in case, though not needed here
sys.setrecursionlimit(2000)

def main():
    # Read all input from stdin
    input_data = sys.stdin.read().strip()
    if not input_data:
        return
    
    # Parse integer X
    X = int(input_data)
    
    # N! = X
    # Since X <= 3 * 10^18, N is small (specifically N <= 20 since 21! > 3*10^18)
    # We can find N by iterating from 1.
    
    ans = 1
    fact = 1
    
    # Loop until factorial equals or exceeds X
    # Since X is guaranteed to be a factorial, we can stop when fact == X
    # or simply when fact >= X because if it exceeds it without equality, it's not possible per constraints.
    # But since max N is small, simple iteration is safest and easiest.
    
    while fact < X:
        ans += 1
        fact *= ans
        
    # Given the guarantee, fact should be exactly X here.
    if fact == X:
        print(ans)
    else:
        # This case implies X is not a factorial, which contradicts the problem statement.
        # However, for robustness, we might check. 
        # Actually, if fact > X, then there's no solution. 
        # But with guarantee, we print ans.
        print(ans)

if __name__ == '__main__':
    main() is_correct=True justification=
