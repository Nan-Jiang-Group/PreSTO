[run_low_temp_vllm] INFO: sample 0 response_length=10009 prediction=import sys

def main():
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    X = int(input_data[0])
    
    total_sum = 0
    # 9x9 multiplication table values
    # i ranges from 1 to 9, j ranges from 1 to 9
    for i in range(1, 10):
        for j in range(1, 10):
            product = i * j
            if product != X:
                total_sum += product
                
    print(total_sum)

if __name__ == '__main__':
    main() is_correct=True justification=
