        # We need to check if swapping A[i] and A[i+1] results in target
        # for any i in 0..3
        
        # Optimization: check if A == target first? 
        # If A == target, then any swap unsorts it. So answer is No.
        # The loop below will check swaps. If A == target, B will be unsorted, so possible remains False.
        # So loop is sufficient.

        can_sort = False
        for i in range(4): # 0 to 3
            # Create a copy
            temp = A[:]
            # Swap
            temp[i], temp[i+1] = temp[i+1], temp[i]
            # Check sorted
            if temp == target:
                can_sort = True
                break
        
        if can_sort:
