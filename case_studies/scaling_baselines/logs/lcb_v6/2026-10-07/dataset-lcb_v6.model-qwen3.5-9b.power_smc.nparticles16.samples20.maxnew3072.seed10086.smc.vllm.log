[run_power_smc_vllm] INFO: sample 5 response_length=10034 prediction=import sys

def main():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    
    if not input_data:
        return

    iterator = iter(input_data)
    
    try:
        # Read N and D
        N = int(next(iterator))
        D = int(next(iterator))
        
        snakes = []
        # Read the N snakes' properties
        for _ in range(N):
            T = int(next(iterator))
            L = int(next(iterator))
            snakes.append((T, L))
            
        # For each k from 1 to D
        for k in range(1, D + 1):
            max_weight = 0
            # Find the maximum weight among all snakes
            for T, L in snakes:
                weight = T * (L + k)
                if weight > max_weight:
                    max_weight = weight
            print(max_weight)
            
    except StopIteration:
        pass

if __name__ == '__main__':
    main() is_correct=True justification=
