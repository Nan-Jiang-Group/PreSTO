def solve():
    # Read input from stdin
    try:
        line = sys.stdin.read().split()
        if not line:
            return
        A = [int(x) for x in line]
    except ValueError:
        return

    target = [1, 2, 3, 4, 5]
    
    # Check if A can be sorted by exactly one adjacent swap
    # Since the length is fixed at 5, we can just try all 4 possible adjacent swaps.
    
    found = False
    for i in range(4):
        # Create a copy to simulate the swap
        temp = A[:]
        # Swap adjacent elements at index i and i+1
        temp[i], temp[i+1] = temp[i+1], temp[i]
        
        # Check if the result matches the sorted sequence
        if temp == target:
            found = True
            break
            
    if found:
        print("Yes")
    else:
        print("No")

