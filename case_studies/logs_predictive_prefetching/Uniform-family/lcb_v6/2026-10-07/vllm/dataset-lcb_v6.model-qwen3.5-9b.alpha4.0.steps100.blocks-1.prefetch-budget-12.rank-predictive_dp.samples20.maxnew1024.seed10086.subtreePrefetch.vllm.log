```python
import sys

def solve():
    # Reading input from stdin
    # The input format is "A B" on a single line
    try:
        line = sys.stdin.read().strip()
        if not line:
            return
        parts = line.split()
        A = int(parts[0])
        B = int(parts[1])
        
        # Calculating the square of A + B
        result = (A + B) ** 2
        
        # Printing the result to stdout
        print(result)
    except Exception:
        pass

if __name__ == "__main__":
    solve()
```
