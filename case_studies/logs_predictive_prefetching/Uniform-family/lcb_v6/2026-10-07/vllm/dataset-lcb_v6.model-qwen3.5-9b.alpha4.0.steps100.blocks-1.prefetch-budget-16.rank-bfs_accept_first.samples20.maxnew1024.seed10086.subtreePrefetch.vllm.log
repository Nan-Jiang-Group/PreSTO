import sys

def main():
    # Read A and B
    line = sys.stdin.read().split()
    if not line:
        return
    A = int(line[0])
    B = int(line[1])
    
    # Calculate result
    result = (A + B) ** 2
    
    # Print result
    print(result)

if __name__ == '__main__':
    main()
```
