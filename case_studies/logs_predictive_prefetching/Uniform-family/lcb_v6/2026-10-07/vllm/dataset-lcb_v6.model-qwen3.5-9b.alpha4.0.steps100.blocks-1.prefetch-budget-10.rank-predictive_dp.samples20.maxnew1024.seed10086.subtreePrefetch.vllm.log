import sys

def solve():
    # Read the input string S
    # Using sys.stdin.read().strip() handles potential surrounding whitespace/newlines
    s = sys.stdin.read().strip()
    
    # The string format is digit 'x' digit
    # Extract the first digit
    digit1 = int(s[0])
    
    # Extract the second digit
    digit2 = int(s[2])
    
    # Calculate the product
    result = digit1 * digit2
    
    # Print the result
    print(result)

if __name__ == '__main__':
    solve()
