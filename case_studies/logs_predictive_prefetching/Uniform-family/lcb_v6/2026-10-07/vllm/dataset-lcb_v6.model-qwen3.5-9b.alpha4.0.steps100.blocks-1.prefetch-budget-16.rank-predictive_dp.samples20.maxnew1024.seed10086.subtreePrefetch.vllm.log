import sys

def main():
    # Read S from standard input
    S = sys.stdin.read().strip()
    
    # Extract the digits
    # S[0] is the first digit
    # S[2] is the third digit
    # S[1] is 'x'
    
    num1 = int(S[0])
    num2 = int(S[2])
    
    # Calculate product
    result = num1 * num2
    
    # Print the result
    print(result)

if __name__ == '__main__':
    main()
```
