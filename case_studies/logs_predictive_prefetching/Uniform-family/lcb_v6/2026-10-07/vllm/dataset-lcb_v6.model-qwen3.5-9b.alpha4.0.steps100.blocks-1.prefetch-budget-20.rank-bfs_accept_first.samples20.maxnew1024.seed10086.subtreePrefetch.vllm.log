import sys

def solve():
    # Read S from stdin
    S = sys.stdin.read().strip()
    
    # Extract digits
    # S[0] is the first digit
    # S[2] is the second digit
    # S[1] is 'x'
    
    if len(S) >= 3:
        num1 = int(S[0])
        num2 = int(S[2])
        print(num1 * num2)

if __name__ == '__main__':
