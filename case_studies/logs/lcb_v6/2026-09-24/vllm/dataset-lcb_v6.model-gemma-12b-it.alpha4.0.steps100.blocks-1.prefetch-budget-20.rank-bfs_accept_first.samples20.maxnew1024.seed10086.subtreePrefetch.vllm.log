import sys

def solve():
    # Read input from stdin
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    try:
        R = int(input_data[0])
    except ValueError:
        return

    # The problem asks to find the number of integer pairs (i, j) such that
    # the four corners of a unit square centered at (i+0.5, j+0.5) are
    # within distance R from the origin (0,0).
    # The four corners are:
    # (i, j), (i+1, j), (i, j+1), (i+1, j+1)
    #
    # For a square to be completely contained within the circle of radius R,
    # all four of its corners must satisfy x^2 + y^2 <= R^2.
    #
    # Since the circle is centered at (0,0), the corner furthest from the origin
    # determines if the square is contained.
    #
    # For a square in the first quadrant (i >= 0, j >= 0), the furthest corner
    # is (i+1, j+1).
    # For a square in the second quadrant (i < 0, j >= 0), the furthest corner
    # is (i, j+1).
    # For a square in the third quadrant (i < 0, j < 0), the furthest corner
    # is (i, j).
    # For a square in the fourth quadrant (i >= 0, j < 0), the furthest corner
    # is (i+1, j).
    
    # Let's simplify the logic:
    # A square is defined by its bottom-left corner (i, j).
    # The four corners are (i, j), (i+1, j), (i, j+1), (i+1, j+1).
    # The condition is:
    # max(i^2 + j^2, (i+1)^2 + j^2, i^2 + (j+1)^2, (i+1)^2 + (j+1)^2) <= R^2
    
    # This is equivalent to:
    # (i_max)^2 + (j_max)^2 <= R^2
    # where i_max = i+1 if i >= 0 else i
    # and j_max = j+1 if j >= 0 else j
    
    # Let's re-index. Let x = i_max and y = j_max.
    # x and y are the coordinates of the corner furthest from the origin.
    # For any pair (x, y) such that x^2 + y^2 <= R^2, does it correspond
    # to exactly one square?
    #
    # If x > 0 and y > 0:
    # The furthest corner is (x, y). The square's bottom-left corner is (x-1, y-1).
    # Since x > 0 and y > 0, x-1 >= 0 and y-1 >= 0.
    #
    # If x < 0 and y > 0:
    # The furthest corner is (x, y). The square's bottom-left corner is (x, y-1).
    # Since x < 0 and y > 0, x < 0 and y-1 >= 0.
    #
    # If x < 0 and y < 0:
    # The furthest corner is (x, y). The square's bottom-left corner is (x+1, y+1).
    # Since x < 0 and y < 0, x+1 <= 0 and y+1 <= 0.
    #
    # If x > 0 and y < 0:
    # The furthest corner is (x, y). The square's bottom-left corner is (x-1, y).
    # Since x > 0 and y < 0, x-1 >= 0 and y < 0.
    
    # In all cases, for every pair of integers (x, y) such that x^2 + y^2 <= R^2,
    # there is exactly one square whose furthest corner is (x, y).
    #
    
