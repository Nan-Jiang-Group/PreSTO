import sys

# Set recursion limit for deep recursion if needed
sys.setrecursionlimit(2000000)

def solve():
    # Read all inputs from stdin
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    # Parse the first integer N
    try:
