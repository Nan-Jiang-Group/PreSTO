import sys

# Set the recursion limit for deep recursion
sys.setrecursionlimit(200000)

def solve():
    # Read all input values from stdin
    input_data = sys.stdin.read().split()
    if not input_data:
        return

    # Parse the input values
    N = int(input_data[0])
    M = int(input_data[1])
    P = []
    for i in_range(N):
        P.append(int(input_data[2+i]))
    
    # The problem asks for the maximum number of units you can buy in total
    # The cost of buying x units of the i-th product is x^2 * P_i.
    # The total cost is the sum of (x_i^2 * P_i) for all i.
    # We want to maximize sum(x_i) subject to sum(x_i^2 * P_i) <= M.
    
    # This is a Lagrange multiplier problem.
    # Let L = sum(x_i) - lambda * (sum(x_i^2 * P_i) - M).
    # The derivative with/respect to x_i is 1 - 2 * lambda * P_i.
