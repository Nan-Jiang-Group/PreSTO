import sys

# Increase recursion depth for deep trees if necessary
sys.setrecursionlimit(300000)

def solve():
    # Read N from stdin
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    n = int(input_data[0])
    
    # The problem asks for the sum of f(P) over all permutations P of (1, 2, ..., N).
    # f(P) is formed by concatenating the decimal representations of elements in P.
    # Let s_i be the string representation of integer i.
    # Let L_i be the length of s_i.
    # f(P) = s_{p1} + s_{p2} + ... + s_{pN}
    # This is equivalent to:
    # f(P) = \sum_{i=1}^N (value of s_{pi}) * 10^{\sum_{j=i+1}^N L_{pj}}
    
    # Let S = \sum_{i=1}^N L_i be the total length of all strings.
    # For a fixed i \in {1, ..., N}, it appears at position k \in {1, ..., N}
    # in (N-1)! permutations.
    # When i is at position k, its contribution to the sum is:
    # (value of s_i) * 10^{\sum_{j=k+1}^N L_{pj}}
    
    # Let's simplify. The total sum is \sum_{P} \sum_{k=1}^N (value of s_{pk}) * 10^{\sum_{j=k+1}^N L_{pj}}
    # Swap the summations: \sum_{i=1}^N (value of s_i) * \sum_{P} 10^{\sum_{j=k+1}^N L_{pj}}
    # where k is the position of i in permutation P.
    
    # Let's fix i and its position k. The remaining N-1 elements are distributed 
    # in the remaining N-1 positions.
    # The sum of 10^{\sum_{j=k+1}^N L_{pj}} over all permutations of the remaining N-1 elements
    # is (N-1)! * (average value of 10^{\sum_{j=k+1}^N L_{pj}}).
    
    # This is still slightly complex. Let's use the property of linearity of expectation.
    # Total Sum = (N-1)! * \sum_{i=1}^N (value of s_i) * \sum_{k=1}^N E[10^{\sum_{j=k+1}^N L_{pj}} | i is at k]
    
    # Let the lengths of the strings of the other N-1 elements be {L_j : j \neq i}.
    # At position k, there are (N-k) elements to the right of i.
    # The sum of 10^{\sum_{j=k+1}^N L_{pj}} over all permutations of the other N-1 elements
    # is (N-1)! * ( \sum_{subset T \subset \{L_j : j \neq i\}, |T|=N-k} 10^{\sum_{L \in T} L} ) / \binom{N-1}{N-k}
    
    # This is getting very complicated. Let's rethink.
    # Total Sum = \sum_{P} \sum_{k=1}^N \sum_{i=1}^N [p_k = i] * (value of s_i) * 10^{\sum_{j=k+1}^N L_{pj}}
    # Total Sum = \sum_{i=1}^N (value of s_i) * \sum_{k=1}^N \sum_{P: p_k=i} 10^{\sum_{j=k+1}^N L_{pj}}
    
    # Let R = N-k be the number of elements to the right of i.
    # For a fixed i and fixed R, there are \binom{N-1}{R} ways to choose the elements to the right,
    # and R! * (N-1-R)! ways to arrange them.
    # Sum_{P: p_k=i} 10^{\sum_{j=k+1}^N L_{pj}}
