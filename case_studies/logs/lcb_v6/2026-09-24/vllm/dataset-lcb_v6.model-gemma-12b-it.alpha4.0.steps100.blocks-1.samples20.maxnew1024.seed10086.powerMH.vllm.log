[run_powersampling_mh_vllm] INFO: sample 5 response_length=3218 prediction=import sys

def solve():
    # Read all input from stdin
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    # Parse N and D
    N = int(input_data[0])
    D = int(input_data[1])
    
    # Parse the thickness and length of each snake
    snakes = []
    idx = 2
    for _ in range(N):
        t = int(input_data[idx])
        l = int(input_data[idx+1])
        snakes.append((t, l))
        idx += 2
        
    # For each k from 1 to D
    for k in range(1, D + 1):
        max_weight = -1
        # Calculate the weight of each snake with increased length
        for t, l in snakes:
            current_weight = t * (l + k)
            if current_weight > max_weight:
                max_weight = current_weight
        # Print the weight of the heaviest snake for this k
        print(max_weight)

if __name__ == "__main__":
    solve() is_correct=True justification=
