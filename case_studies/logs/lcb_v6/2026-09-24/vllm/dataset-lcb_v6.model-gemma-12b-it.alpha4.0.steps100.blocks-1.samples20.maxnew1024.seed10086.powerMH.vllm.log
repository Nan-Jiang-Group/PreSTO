def solve():
    # Read N and M
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    N = int(input_data[0])
    M = int(input_data[1])
    P = list(map(int, input_data[2:]))
    
    # The cost function is f(k_1, ..., k_N) = sum(k_i^2 * P_i)
    # We want to maximize sum(k_i) subject to sum(k_i^2 * P_i) <= M.
    # This is a convex optimization problem. To maximize the sum, 
    # we should prioritize products with smaller P_i.
    # However, since we want to maximize the sum of k_i, we should 
    # distribute the "increments" such that the marginal cost is minimized.
    # The cost of increasing k_i to k_i + 1 is (k_i+1)^2*P_i - k_i^2*P_i = (2*k_i + 1)*P_i.
    
    # Let K be the total number of units. We want to find the maximum K.
    # For a fixed K, the minimum cost is achieved by distributing K units
    # among the N products such that the marginal costs (2*k_i + 1)*P_i 
    # are as balanced as possible.
    # Specifically, for a fixed K, we want to minimize sum(k_i^2 * P_i) 
    # subject to sum(k_i) = K.
    # Using Lagrange multipliers (conceptually), the optimal k_i should satisfy
    # (2*k_i + 1)*P_i \approx \lambda.
    # So k_i \approx (lambda / 2 - P_i) / P_i = lambda/2P_i - 1.
    # This means k_i is roughly proportional to 1/P_i.
    
    # Since the cost function is monotonically increasing with K, 
    # we can binary search for the maximum K.
    # Max possible K: if P_i = 1, K^2 <= 10^18 => K <= 10^9.
    
    def get_min_cost(K):
        # To minimize sum(k_i^2 * P_i) given sum(k_i) = K:
        # We want to pick k_i such that (2*k_i + 1)*P_i is minimized.
        # This is equivalent to saying we always pick the product i 
        # that has the smallest (2*k_i + 1)*P_i.
        # This is still hard to compute directly for large K.
        # However, we can observe that for a fixed K, the optimal k_i 
        # are such that (2*k_i + 1)*P_i is "close" to some value L.
        # (2*k_i + 1)*P_i <= L  => 2*k_i*P_i + P_i <= L => k_i <= (L - P_i) / (2*P_i)
        # Let k_i = floor((L - P_i) / (2*P_i)). If L < P_i, k_i = 0.
        # We need to find L such that sum(k_i) is as close to K as possible.
        
        # Binary search for L
        low_L = 0
        high_L = 2 * 10**18 # Sufficiently large
        best_L = high_L
        
        while low_L <= high_L:
            mid_L = (low_L + high_L) // 2
            current_K = 0
            for p in P:
                if mid_L >= p:
                    current_K += (mid_L - p) // (2 * p)
                if current_K > K: break # Optimization
            
            if current_K >= K:
                best_L = mid_L
                high_L = mid_L - 1
            else:
                low_L = mid_L + 1
        
        # With best_L, we might have sum(k_i) >= K.
        # is_correct=False justification=Code is incorrect.
