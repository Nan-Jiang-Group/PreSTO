[run_powersampling_mh_vllm] INFO: sample 12 response_length=2974 prediction=import sys

def solve():
    # Read X from standard input
    line = sys.stdin.readline()
    if not line:
        return
    x = int(line.strip())
    
    # Since X <= 3 * 10^18, and 20! is approximately 2.4 * 10^18,
    # and 21! is approximately 5.1 * 10^19, N will be small.
    # We can simply iterate and multiply numbers until we reach X.
    
    current_factorial = 1
    n = 1
    while current_factorial < x:
        n += 1
        current_factorial *= n
        
    print(n)

if __name__ == "__main__":
    solve() is_correct=True justification=
