import bisect

def solve():
    # Read N from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    n = int(input_data[0])
    # Read the sizes of the N mochi
    a = list(map(int, input_data[1:]))
    
    # To maximize the number of kagamimochi, we can use a greedy approach.
    # We want to pair the smallest available mochi with the smallest possible 
    # mochi that is at least twice its size.
    # This is because using a larger mochi as the base for a small mochi 
    # might prevent us from forming another kagamimochi later.
    
    # However, a simpler greedy approach that works:
    # Iterate through the mochi from smallest to largest.
    # If a mochi is not already used as a "top" part of a kagamimochi,
    # try to find the smallest mochi that can serve as its "bottom" part.
    
    # Actually, the standard greedy for this type of matching (where we want 
    # to match elements with a condition like a <= b/2) is:
    # Iterate through the mochi from largest to smallest.
    # For each mochi, if it's available, try to pair it with the largest 
    # available mochi that is at most half its size.
    
    # Let's refine the greedy:
    # We want to pair as many as possible. Let's use a two-pointer approach.
    # We want to pair a small mochi (a) with a large mochi (b) such that a <= b/2.
    # To maximize pairs, we should pair the smallest available mochi with the 
    # smallest possible mochi that satisfies the condition.
    
    # Let's use a pointer 'i' for the small mochi and 'j' for the large mochi.
    # Since the array is sorted, we can iterate 'i' from 0 to N-1.
    # For each 'i', we find the first 'j' such that a[j] >= 2 * a[i].
    # If we find such a 'j', we pair them and move both pointers.
    
    # Wait, the standard "matching" greedy:
    # For each mochi (from smallest to largest), if it's not used, 
    # find the smallest mochi that is >= 2 * current_mochi.
    
    # Let's trace Sample 1: 2, 3, 4, 4, 7, 10
    # i=0, a[0]=2. Smallest j such that a[j] >= 4 is j=2 (a[2]=4).
    # Pair (2, 4). Remaining: 3, 4, 7, 10.
    # i=1, a[1]=3. Smallest j such that a[j] >= 6 is j=4 (a[4]=7).
    # Pair (3, 7). Remaining: 4, 10.
    # i=2 is used.
    # i=3, a[3]=4. Smallest j such that a[j] >= 8 is j=5 (a[5]=10).
    # Pair (4, 10). Remaining: none.
    # Total 3. Correct.
    
    # Implementation:
    # Use a boolean array to keep track of used mochi.
    # Use a pointer for the "large" mochi to ensure O(N) complexity.
    
    used = [False] * n
    count = 0
    j = 0
    for i in range(n):
        if used[i]:
            continue
        
        # Find the first j that is not used and a[j] >= 2 * a[i]
        # Since a is sorted, we can just move j forward.
        while j < n and (used[j] or a[j] < 2 * a[i]):
            j += 1
            
        if j < n:
            used[i] = True
            used[j] = True
            count += 1
            # j will be incremented in the next iterations or by the while loop
            
    print(count)

