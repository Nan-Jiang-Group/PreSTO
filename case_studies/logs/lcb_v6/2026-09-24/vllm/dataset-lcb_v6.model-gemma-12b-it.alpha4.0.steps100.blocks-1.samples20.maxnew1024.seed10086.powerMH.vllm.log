def solve():
    # Read N and X
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    N = int(input_data[0])
    X = int(input_data[1])
    
    foods = []
    idx = 2
    for _ in range(N):
        v = int(input_data[idx])
        a = int(input_data[idx+1])
        c = int(input_data[idx+2])
        foods.append((v, a, c))
        idx += 3
        
    # Group foods by vitamin type
    groups = [[], [], []]
    for v, a, c in foods:
        groups[v-1].append((a, c))
        
    # We want to find the maximum K such that we can get at least K units 
    # of each vitamin within X calories.
    # This is a variation of the knapsack problem.
    # Since we need to satisfy three independent vitamin requirements,
    # we can treat each vitamin group as a separate knapsack problem.
    
    # dp[v][k] = minimum calories to get at least k units of vitamin v
    # Max possible units of a vitamin is N * 200,000, but we only care 
    # about values up to a certain bound. 
    # Wait, the answer K can be up to 200,000 * 5000 / 3? No, 
    # the total calories X is small (5000). 
    # The maximum possible K is limited by the total units available.
    # However, the number of calories is the limiting factor.
    
    # Let's re-evaluate:
    # For each vitamin type i, let f(i, k) be the minimum calories to get 
    # at least k units of vitamin i.
    # Then we want to find max K such that f(1, K) + f(2, K) + f(3, K) <= X.
    
    # To find f(i, k), we use a standard 0/1 knapsack where 
    # weight is calories and value is vitamin units.
    # But we want min calories for a target vitamin units.
    # Since calories are small (X <= 5000), we can use:
    # dp[c] = max units of vitamin i for exactly c calories.
    
    def get_min_calories(items, max_x):
        # dp[c] = max units of vitamin for c calories
        dp = [0] * (max_x + 1)
        for a, c in items:
            for j in range(max_x, c - 1, -1):
                if dp[j-c] + a > dp[j]:
                    dp[j] = dp[j-c] + a
        
        # Now we need to convert this to: min_c[k] = min calories for at least k units.
        # But k can be very large. Let's flip it.
        # Actually, we can just use the dp[c] array directly.
        # Let's find the max K such that there exist c1, c2, c3 
        # where c1+c2+c3 <= X and dp1[c1] >= K, dp2[c2] >= K, dp3[c3] >= K.
        return dp

    dp1 = get_min_calories(groups[0], X)
    dp2 = get_min_calories(groups[1], X)
    dp3 = get_min_calories(groups[2], X)
    
    # We need to find max K such that there exist c1, c2, c3 
    # with c1+c2+c3 <= X and dp1[c1] >= K, dp2[c2] >= K, dp3[c3] >= K.
    # This is equivalent to:
