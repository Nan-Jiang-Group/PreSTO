def solve():
    # Read L and R from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    L = int(input_data[0])
    R = int(input_data[1])

    # The problem asks for the count of Snake numbers in [L, R].
    # A Snake number is a number where the first digit is strictly larger 
    # than all other digits.
    # Let f(N) be the count of Snake numbers in [1, N].
    # The answer is f(R) - f(L-1).

    def count_snake_numbers(N):
        if N < 10:
            return 0
        
        s_n = str(N)
        length = len(s_n)
        total = 0
        
        # Count Snake numbers with fewer digits than N
        # For a fixed length 'len_i' and first digit 'd' (1 to 9):
        # The other (len_i - 1) digits can be any value from 0 to (d-1).
        # There are d^(len_i - 1) such numbers.
        for len_i in range(2, length):
            for d in range(1, 10):
                total += d**(len_i - 1)
        
        # Count Snake numbers with the same number of digits as N
        # Let the first digit of N be 'first_digit'.
        first_digit = int(s_n[0])
        
        # For first digits 'd' strictly less than 'first_digit'
        # All such numbers are Snake numbers if the subsequent digits are < d.
        for d in range(1, first_digit):
            total += d**(length - 1)
            
        # For the first digit equal to 'first_digit'
        # We need to count how many numbers X <= N start with 'first_digit'
        # such that all other digits are < first_digit.
        # This is a digit DP style approach or a recursive count.
        
        # Let's use a recursive function with memoization to count 
        # numbers of length 'length' starting with 'first_digit' 
        # where all digits are < 'first_digit' and the number <= N.
        
        memo = {}

        def count_with_prefix(idx, is_less, current_s):
            state = (idx, is_less)
            if state in memo:
                return memo[state]
            
            if idx == length:
                return 1
            
            res = 0
            limit = int(s_n[idx]) if not is_less else first_digit - 1
            
            # The digits must be strictly less than first_digit
            # and also satisfy the upper bound N.
            upper = min(limit, first_digit - 1)
            
            for d in range(upper + 1):
                new_is_less = is_less or (d < limit)
                res += count_with_prefix(idx + 1, new_is_less, current_s)
            
            memo[state] = res
            return res

        # Special case: the first digit is already fixed as first_digit.
        # We need to count numbers of the form first_digit + [digits < first_digit]
        # that are <= N.
        # Since the first digit is fixed, we just need to check the remaining digits.
        
        # Let's refine the logic for the same length:
        # We want to count numbers X = d_1 d_2 ... d_k such that:
        # 1. d_1 = first_digit
        # 2. d_i < d_1 for i > 1
        # 3. X <= N
        
        # This can be solved by iterating through the digits of N.
        # If at some position i, we pick a digit d < s_n[i], 
        # then all subsequent positions can be any digit from 0 to d_1 - 1.
        # If we pick d = s_n[i], we continue to the next position.
        # If we pick d > s_n[i] or d >= d_1, it's invalid.
        
        # However, the condition is d_i < d_1. is_correct=False justification=Code is incorrect.
