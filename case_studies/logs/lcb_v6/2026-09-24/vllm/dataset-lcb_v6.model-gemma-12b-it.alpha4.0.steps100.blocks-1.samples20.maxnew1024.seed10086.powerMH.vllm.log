[run_powersampling_mh_vllm] INFO: sample 9 response_length=2946 prediction=import sys

def solve():
    # Read N, M, A, B
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    N = int(input_data[0])
    M = int(input_data[1])
    A = int(input_data[2])
    B = int(input_data[3])
    
    bad_intervals = []
    idx = 4
    for _ in range(M):
        l = int(input_data[idx])
        r = int(input_data[idx+1])
        bad_intervals.append((l, r))
