    # Iterate through the 9x9 multiplication table
    # Rows and columns are indexed 1 to 9
    for i in range(1, 10):
        for j in range(1, 10):
            val = i * j
            # If the value is not X, add it to the total sum
            if val != x:
                total_sum += val
                
    # Print the final sum to standard output
    print(total_sum)

