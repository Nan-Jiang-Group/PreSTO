# Set recursion depth just in case, though not needed for this iterative solution
sys.setrecursionlimit(200005)

def solve():
    # Read N from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    n = int(input_data[0])
    
    MOD = 998244353
    
    # The problem asks for the sum of f(P) over all permutations P of (1, 2, ..., N).
    # f(P) is the concatenation of the decimal representations of elements in P.
    # Let d(i) be the number of digits in the decimal representation of integer i.
    # Let v(i) be the value of integer i.
    
    # Let P = (p_1, p_2, ..., p_n).
    # f(P) = v(p_1) * 10^(sum_{j=2}^n d(p_j)) + v(p_2) * 10^(sum_{j=3}^n d(p_j)) + ... + v(p_n)
    # We want to calculate Sum_{P} f(P) mod MOD.
    # By linearity of expectation (or simply summing over positions):
    # Sum_{P} f(P) = Sum_{i=1}^n Sum_{P} [v(p_i) * 10^(sum_{j=i+1}^n d(p_j))]
    
    # Let D = sum_{k=1}^n d(k).
    # For a fixed position i and a fixed value x in {1, ..., n} at position i:
    # The sum of 10^(sum_{j=i+1}^n d(p_j)) over all permutations where p_i = x is:
    # (n-1)! * Sum_{S \subset {1..n} \setminus {x}, |S|=n-i} 10^(sum_{s \in S} d(s))
    # This looks like a coefficient in a polynomial.
    
    # Let's rephrase:
    # Total Sum = Sum_{x=1}^n v(x) * Sum_{i=1}^n [ (n-1)! * Sum_{S \subset {1..n} \setminus {x}, |S|=n-i} 10^(sum_{s \in S} d(s)) ]
    # Let P(z) = Product_{k=1}^n (1 + z * 10^d(k)).
    # The sum over all subsets S of size k of {1..n} \setminus {x} of 10^(sum_{s \in S} d(s))
    # is the coefficient of z^k in P_x(z) = P(z) / (1 + z * 10^d(x)).
    
    # Let C_k be the coefficient of z^k in P(z).
    # P(z) = Sum_{k=0}^n C_k z^k.
    # Then the coefficient of z^k in P_x(z) can be found using polynomial division or 
    # by observing that P_x(z) * (1 + z * 10^d(x)) = P(z).
    # Let Q_{x,k} be the coefficient of z^k in P_x(z).
    # Q_{x,k} + Q_{x,k-1} * 10^d(x) = C_k  =>  Q_{x,k} = C_k - Q_{x,k-1} * 10^d(x).
    # Since Q_{x,0} = 1, we can compute all Q_{x,k} for a fixed x.
    
    # However, we need Sum_{i=1}^n (n-1)! * Q_{x, n-i} for each x.
    # Let W_x = Sum_{k=0}^{n-1} (n-1)! * Q_{x, k} * (something?) 
    # Wait, the position i corresponds to k = n-i.
    # Sum_{i=1}^n (n-1)! * Q_{x, n-i} = (n-1)! * Sum_{k=0}^{n-1} Q_{x, k}. is_correct=False justification=Code is incorrect.
