        A[i] -= 1  # convert to 0-based index

    # We need to process nodes in topological order
    # First, build the graph and compute in-degree
    from collections import defaultdict, deque

    graph = defaultdict(list)
    in_degree = [0] * N
    for i in range(N):
        a = A[i]
        graph[i].append(a)
        in_degree[a] += 1

    # Topological sort
    q = deque()
    for i in range(N):
        if in_degree[i] == 0:
            q.append(i)
    topo_order = []
    while q:
        u = q.popleft()
        topo_order.append(u)
        for v in graph[u]:
            in_degree[v] -= 1
            if in_degree[v] == 0:
                q.append(v)

    # Now, process in topological order
    # dp[i][v] = number of ways to assign values to first i elements, with x_i = v
    # But since N can be up to 2025, and M up to 2025, we need an efficient way
    # We can use a 1D array for current dp, and update it as we process each node

    # Initialize dp as a list of size M+1 (since values are 1-based)
    dp = [0] * (M + 1)
    dp[0] = 1  # dummy value for 0, which is not used

