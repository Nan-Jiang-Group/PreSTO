import sys

def solve():
    # Read the string S from standard input
    S = sys.stdin.read().strip()
    
    # Extract the first digit
    first_digit = int(S[0])
    
    # Extract the second digit
    second_digit = int(S[2])
    
    # Calculate the product
    result = first_digit * second_digit
    
    # Print the result
    print(result)

