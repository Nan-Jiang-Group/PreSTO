import math

def main():
    input = sys.stdin.read
    data = input().split()
    idx = 0
    t = int(data[idx])
    idx += 1
    results = []
    
    for _ in range(t):
        n, k = int(data[idx]), int(data[idx+1])
        idx += 2
        a = list(map(int, data[idx:idx+n]))
        idx += n
        
        if k == 2:
            # Need at least one even number
            min_ops = float('inf')
            for num in a:
                if num % 2 == 0:
                    min_ops = 0
                    break
            if min_ops == float('inf'):
                # Find the minimal steps to make any number even
                min_ops = min((2 - (num % 2)) % 2 for num in a)
            results.append(min_ops)
        
        elif k == 3:
            # Need at least one multiple of 3
            min_ops = float('inf')
            for num in a:
                if num % 3 == 0:
                    min_ops = 0
                    break
            if min_ops == float('inf'):
                # Find the minimal steps to make any number a multiple of 3
                min_ops = min((3 - (num % 3)) % 3 for num in a)
            results.append(min_ops)
        
        elif k == 4:
            # Need at least two factors of 2
            # Count the number of factors of 2 in the product
            count_2 = 0
