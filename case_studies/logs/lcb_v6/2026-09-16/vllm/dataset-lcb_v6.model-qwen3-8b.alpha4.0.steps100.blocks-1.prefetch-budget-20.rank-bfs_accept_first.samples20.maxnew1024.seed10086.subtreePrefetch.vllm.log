class Solution:
    def count(self, num1: str, num2: str, min_sum: int, max_sum: int) -> int:
        MOD = 10**9 + 7
        
        def subtract_one(s):
            # Subtract 1 from the numeric string s
            s_list = list(s)
            i = len(s_list) - 1
            while i >= 0 and s_list[i] == '0':
                s_list[i] = '9'
                i -= 1
            if i < 0:
                return '0'  # This case shouldn't happen as per constraints
            s_list[i] = str(int(s_list[i]) - 1)
            if s_list[0] == '0' and len(s_list) > 1:
                return ''.join(s_list[1:])
            return ''.join(s_list)
        
        def count_up_to(s):
            # Convert s to a list of digits
            digits = list(map(int, s))
            n = len(digits)
            
            # Memoization cache
            from functools import lru_cache
            
            @lru_cache(maxsize=None)
            def dp(pos, tight, sum_so_far):
                if pos == n:
                    # Check if sum_so_far is within the range
                    return 1 if min_sum <= sum_so_far <= max_sum else 0
                limit = digits[pos] if tight else 9
                total = 0
                for d in range(0, limit + 1):
                    new_tight = tight and (d == limit)
                    new_sum = sum_so_far + d
                    total += dp(pos + 1, new_tight, new_sum)
                return total
            
