```python
import sys

def solve():
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    iterator = iter(input_data)
    try:
        t = int(next(iterator))
    except StopIteration:
        return

    for _ in range(t):
        s = next(iterator)
        
        # Check if already "abc"
        if s == "abc":
            print("YES")
