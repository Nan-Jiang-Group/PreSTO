[run_powersampling_mh_vllm] INFO: sample 19 response_length=3737 prediction=class Solution:
    def semiOrderedPermutation(self, nums: List[int]) -> int:
        n = len(nums)
        # Find current positions of 1 and n
        pos1 = nums.index(1)
        posn = nums.index(n)
        
        # Operations to move 1 to the front (index 0)
        # Each swap moves 1 one step left, so we need pos1 swaps
        ops = pos1
        
        # Operations to move n to the end (index n-1)
        # Each swap moves n one step right, so we need (n - 1 - posn) swaps
        ops += (n - 1 - posn)
        
        # If 1 is to the right of n, moving 1 to the left will cross n,
        # which would effectively move n one step to the right as well.
        # So we save one operation because the crossing swap does both jobs.
        if pos1 > posn:
            ops -= 1
            
        return ops is_correct=True justification=
