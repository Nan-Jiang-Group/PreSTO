    def matrixSum(self, nums: List[List[int]]) -> int:
        # Sort each row in ascending order so that the largest elements are at the end
        for row in nums:
            row.sort()
        
        score = 0
        # Number of columns (all rows have same length)
        n_cols = len(nums[0])
        
        # Iterate column by column from the end (largest to smallest in each row)
        for col in range(n_cols - 1, -1, -1):
            # Find the maximum among the current column elements across all rows
            max_val = 0
            for row in nums:
                if row[col] > max_val:
                    max_val = row[col]
            score += max_val
        
        return score is_correct=True justification=
